    "@npanel/env": "workspace:*",
    "@react-email/components": "0.5.7",
    "@react-email/render": "^2.0.4",
    "@trpc/server": "catalog:",
    "@types/ssh2": "^1.15.5",
    "@upstash/qstash": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "prettier": "^3.5.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "replicate": "catalog:",
    "resend": "^6.1.2",
    "ssh2": "^1.17.0",
