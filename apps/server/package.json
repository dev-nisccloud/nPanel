{
  "name": "server",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "bun build ./src/index.ts --outfile dist/index.mjs --target node --format esm --minify --sourcemap --external google-ads-api --external googleapis --external google-proto-files --banner \"import { fileURLToPath as __fileURLToPath } from 'node:url'; import { dirname as __path_dirname } from 'node:path'; const __filename = __fileURLToPath(import.meta.url); const __dirname = __path_dirname(__filename);\"",
    "check-types": "tsc -b || true",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@npanel/api": "workspace:*",
    "@npanel/auth": "workspace:*",
    "@npanel/db": "workspace:*",
    "@npanel/env": "workspace:*",
    "@react-email/components": "0.5.7",
    "@react-email/render": "^2.0.4",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^6.1.2",
    "uploadthing": "^7.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
