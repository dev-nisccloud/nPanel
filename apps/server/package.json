{
  "name": "server",
  "version": "0.1.0",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b || true",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "seed:zeepo-ai-agent": "bun run src/scripts/seed-zeepo-ai-agent-product.ts",
    "seed:nisc-email-marketing": "bun run src/scripts/seed-nisc-email-marketing-product.ts",
    "seed:creatives-design": "bun run src/scripts/seed-creatives-design-product.ts",
    "seed:seo-reports": "bun run src/scripts/seed-seo-reports-product.ts",
    "seed:media-buying": "bun run src/scripts/seed-media-buying-product.ts",
    "seed:web-hosting": "bun run src/scripts/seed-web-hosting-product.ts",
    "seed:email-hosting": "bun run src/scripts/seed-email-hosting-product.ts",
    "seed:wordpress-hosting": "bun run src/scripts/seed-wordpress-hosting-product.ts",
    "seed:hosting-products": "bun run src/scripts/seed-web-hosting-product.ts && bun run src/scripts/seed-email-hosting-product.ts && bun run src/scripts/seed-wordpress-hosting-product.ts",
    "seed:planless-services": "bun run src/scripts/seed-planless-services.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@npanel/api": "workspace:*",
    "@npanel/auth": "workspace:*",
    "@npanel/db": "workspace:*",
    "@npanel/env": "workspace:*",
    "@react-email/components": "0.5.7",
    "@react-email/render": "^2.0.4",
    "@trpc/server": "catalog:",
    "@types/ssh2": "^1.15.5",
    "@upstash/qstash": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "prettier": "^3.5.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "replicate": "catalog:",
    "resend": "^6.1.2",
    "ssh2": "^1.17.0",
    "svix": "catalog:",
    "uploadthing": "^7.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "^5"
  }
}