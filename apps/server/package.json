{
  "name": "server",
  "version": "0.1.0",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b || true",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "seed:zeepo-ai-agent": "bun run src/scripts/seed-zeepo-ai-agent-product.ts",
    "seed:zeepo-ai": "bun run src/scripts/seed-zeepo-ai-product.ts",
    "seed:nisc-email-marketing": "bun run src/scripts/seed-nisc-email-marketing-product.ts",
    "seed:creatives-design": "bun run src/scripts/seed-creatives-design-product.ts",
    "seed:seo-reports": "bun run src/scripts/seed-seo-reports-product.ts",
    "seed:media-buying": "bun run src/scripts/seed-media-buying-product.ts",
    "seed:web-hosting": "bun run src/scripts/seed-web-hosting-product.ts",
    "seed:email-hosting": "bun run src/scripts/seed-email-hosting-product.ts",
    "seed:wordpress-hosting": "bun run src/scripts/seed-wordpress-hosting-product.ts",
    "seed:hosting-products": "bun run src/scripts/seed-web-hosting-product.ts && bun run src/scripts/seed-email-hosting-product.ts && bun run src/scripts/seed-wordpress-hosting-product.ts",
    "seed:planless-services": "bun run src/scripts/seed-planless-services.ts",
    "seed:one-time-services": "bun run src/scripts/seed-one-time-services-product.ts",
    "migrate:planless-product-ids": "bun run src/scripts/migrate-planless-product-ids.ts",
    "migrate:web-hosting-product-ids": "bun run src/scripts/migrate-web-hosting-product-ids.ts",
    "migrate:wordpress-hosting-product-ids": "bun run src/scripts/migrate-wordpress-hosting-product-ids.ts",
    "etims:certification": "bun --no-env-file --env-file=./.env.etims-certification run src/scripts/kra-etims-certification-test.ts",
    "etims:certification:env": "bun --no-env-file run src/scripts/write-etims-cert-env.ts",
    "etims:certification:probe": "bun --no-env-file --env-file=./.env.etims-certification run src/scripts/kra-etims-probe-unique-result.ts",
    "etims:golive-invoice": "bun run src/scripts/kra-etims-golive-invoice.ts",
    "etims:sync-classifications": "bun --no-env-file --env-file=./.env run src/scripts/etims-sync-item-classifications.ts",
    "etims:sync-classifications:prod": "bun --no-env-file --env-file=./.env.production run src/scripts/etims-sync-item-classifications.ts",
    "etims:sync-codes": "bun --no-env-file --env-file=./.env run src/scripts/etims-sync-codes.ts",
    "etims:sync-codes:prod": "bun --no-env-file --env-file=./.env.production run src/scripts/etims-sync-codes.ts",
    "etims:mixed-sale": "bun --no-env-file --env-file=./.env run src/scripts/etims-create-product-and-mixed-sale.ts",
    "etims:discount-sale": "bun --no-env-file --env-file=./.env run src/scripts/etims-three-products-discount-sale.ts",
    "mock:invoice-pdfs": "bun run src/scripts/mock-invoice-pdfs.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@npanel/api": "workspace:*",
    "@npanel/auth": "workspace:*",
    "@npanel/db": "workspace:*",
    "@npanel/env": "workspace:*",
    "@react-email/components": "0.5.7",
    "@react-email/render": "^2.0.4",
    "@sentry/bun": "^10.69.0",
    "@sentry/hono": "^10.69.0",
    "@trpc/server": "catalog:",
    "@types/ssh2": "^1.15.5",
    "@upstash/qstash": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "nanoid": "^6.0.0",
    "prettier": "^3.5.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "replicate": "catalog:",
    "resend": "^6.1.2",
    "ssh2": "^1.17.0",
    "svix": "catalog:",
    "uploadthing": "^7.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "^5"
  }
}