{
  "buildCommand": "cd ../.. && turbo build --filter=server",
  "build": {
    "env": {
      "TSCONFIG": "tsconfig.vercel.json"
    }
  },
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}