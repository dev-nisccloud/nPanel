{
  "buildCommand": "cd ../.. && turbo build --filter=www.nisccloud.com",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://npanel.nisccloud.com https://vercel.live; frame-src https://vercel.live; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/zeepo-ai",
      "destination": "/services/zepo-ai",
      "permanent": true
    },
    {
      "source": "/hosting/shared",
      "destination": "/hosting/web-hosting",
      "permanent": true
    },
    {
      "source": "/blog/shared-vs-vps-hosting-kenya",
      "destination": "/blog/web-hosting-vs-vps-kenya",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://npanel-server.nisccloud.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/marketing",
      "destination": "/spa.html"
    },
    {
      "source": "/services/brand-identity",
      "destination": "/services/brand-identity/index.html"
    },
