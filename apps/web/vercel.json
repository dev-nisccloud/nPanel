{
  "buildCommand": "cd ../.. && turbo build --filter=web",
  "outputDirectory": "build/client",
  "build": {
    "env": {
      "TSCONFIG": "tsconfig.vercel.json"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://npanel-server.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}