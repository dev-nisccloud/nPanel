{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "exclude": [
    "src/next-api-routes/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@npanel/api": [
        "../../packages/api/src/index.ts"
      ],
      "@npanel/api/*": [
        "../../packages/api/src/*"
      ],
      "@npanel/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@npanel/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@npanel/db": [
        "../../packages/db/src/index.ts"
      ],
      "@npanel/db/*": [
        "../../packages/db/src/*"
      ],
      "@npanel/env/*": [
        "../../packages/env/src/*"
      ],
      "@npanel/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noCheck": true
  }
}