{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**/*",
        "build/**/*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_URLS",
    "CORS_ORIGIN",
    "HOSTNAME",
    "VITE_PUBLIC_APP_URL",
    "VITE_PUBLIC_FTP_HOST",
    "VITE_PUBLIC_FTP_PORT",
    "VITE_PUBLIC_PLESK_HOST",
    "VITE_PUBLIC_UNSPLASH_ACCESS_KEY",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_WEBHOOK_SECRET",
    "UPLOADTHING_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "QSTASH_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_VITE_SIGNING_KEY",
    "QSTASH_CAMPAIGN_WORKER_ENDPOINT",
    "QSTASH_NISC_ORDER_WORKER_ENDPOINT",
    "QSTASH_IMAGE_GENERATOR_WORKER_ENDPOINT",
    "QSTASH_BACKGROUND_REMOVER_WORKER_ENDPOINT",
    "OPENAI_API_KEY",
    "REPLICATE_API_TOKEN",
    "REPLICATE_WEBHOOK_SIGNING_SECRET",
    "REPLICATE_IMAGE_GENERATOR_WEBHOOK_URL",
    "STABILITY_AI_API_KEY",
    "GOOGLE_ADS_CLIENT_ID",
    "GOOGLE_ADS_CLIENT_SECRET",
    "GOOGLE_ADS_DEVELOPER_TOKEN",
    "GOOGLE_ADS_REDIRECT_URI",
    "GOOGLE_PAGESPEED_API_KEY",
    "GOOGLE_SA_PROJECT_ID",
    "GOOGLE_SA_PRIVATE_KEY_ID",
    "GOOGLE_SA_PRIVATE_KEY",
    "GOOGLE_SA_CLIENT_EMAIL",
    "GOOGLE_SA_CLIENT_ID",
    "GOOGLE_SA_CLIENT_CERT_URL",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_API_VERSION",
    "LINKEDIN_CLIENT_ID",
    "LINKEDIN_CLIENT_SECRET",
    "LINKEDIN_API_VERSION",
    "OPENPROVIDER_USERNAME",
    "OPENPROVIDER_PASSWORD",
    "OPENPROVIDER_BASE_URL",
    "OPENPROVIDER_API_VERSION",
    "OPENPROVIDER_TIMEOUT",
    "PLESK_REST_ENDPOINT",
    "PLESK_SECRET_KEY",
    "PLESK_XML_ENDPOINT",
    "PLESK_XML_USERNAME",
    "PLESK_XML_PASSWORD",
    "MPESA_ENVIRONMENT",
    "MPESA_CONSUMER_KEY",
    "MPESA_CONSUMER_SECRET",
    "MPESA_SHORTCODE",
    "MPESA_PASSKEY",
    "MPESA_PARTY_B",
    "MPESA_ACCOUNT_REFERENCE",
    "MPESA_CALLBACK_URL",
    "MPESA_TRANSACTION_TYPE",
    "ETIMS_CONSUMER_KEY",
    "ETIMS_CONSUMER_SECRET",
    "ETIMS_BASE_URL",
    "ETIMS_TOKEN_URL",
    "KENIC_EPP_HOST",
    "KENIC_EPP_PORT",
    "KENIC_EPP_USERNAME",
    "KENIC_EPP_PASSWORD",
    "KENIC_EPP_TIMEOUT_MS",
    "KENIC_EPP_TLS_SERVERNAME",
    "NODE_ENV",
    "NODE_VERSION",
    "PNPM_VERSION",
    "PRISMA_BINARY_TARGETS"
  ]
}