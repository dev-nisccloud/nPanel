{
  "name": "npanel",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.7.2",
      "better-auth": "1.5.2",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@trpc/client": "^11.7.2",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "pg": "^8.17.1",
      "replicate": "^1.4.0",
      "@upstash/qstash": "^2.10.1",
      "@upstash/redis": "^1.37.0",
      "svix": "^1.15.0",
      "tsdown": "^0.16.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "NODE_OPTIONS='--max-old-space-size=8192' turbo check-types",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "dev:web": "turbo -F web dev",
    "dev:www.nisccloud.com": "turbo -F www.nisccloud.com dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @npanel/db db:push",
    "db:studio": "turbo -F @npanel/db db:studio",
    "db:generate": "turbo -F @npanel/db db:generate",
    "db:migrate": "turbo -F @npanel/db db:migrate"
  },
  "dependencies": {
    "@intercom/messenger-js-sdk": "^0.0.19",
    "@npanel/env": "workspace:*",
    "dotenv": "catalog:",
    "qrcode.react": "^4.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.4"
}