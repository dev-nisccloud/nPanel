# =============================================================================
# JENGA PAYMENT GATEWAY - ENVIRONMENT VARIABLES
# =============================================================================
# Copy these variables to your .env file and fill in your credentials
# Get your credentials from https://jengahq.io (Settings → API Keys)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Mode
# -----------------------------------------------------------------------------
# Use "test" for sandbox testing, "live" for production
JENGA_ENVIRONMENT=test

# -----------------------------------------------------------------------------
# API Credentials (Required)
# -----------------------------------------------------------------------------
# Get these from JengaHQ Portal → Settings → API Keys

# Primary identifier for your Jenga account
JENGA_MERCHANT_CODE=

# Secondary identifier (used for encryption/decryption)
JENGA_CONSUMER_SECRET=

# Required for authentication only
JENGA_API_KEY=

# -----------------------------------------------------------------------------
# Private key (preferred: paste PEM into env — no key files needed)
# -----------------------------------------------------------------------------
# Easiest for local + Cloud Run: one multiline PEM as a single line with \n.
# Generate: openssl genrsa -out jenga-private.pem 2048
# Then convert for .env (PowerShell):
#   (Get-Content jenga-private.pem -Raw) -replace "`r?`n","\n"
# Paste result below. Upload the matching PUBLIC key body to JengaHQ.
JENGA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Optional fallback only: path relative to apps/server cwd
# JENGA_PRIVATE_KEY_PATH=./keys/jenga-private-key.pem

# Public key: upload body (no BEGIN/END) to JengaHQ only — not used as an env var.

# -----------------------------------------------------------------------------
# Callback URLs (Required)
# -----------------------------------------------------------------------------
# URL where user is redirected after payment (must be HTTPS in production)
# Format: https://api.yourdomain.com/api/webhooks/jenga/callback
# Local dev: https://<ngrok>/api/webhooks/jenga/callback
JENGA_CALLBACK_URL=

# URL for Instant Payment Notifications (IPN webhook)
# Format: https://api.yourdomain.com/api/webhooks/jenga/ipn
# Local dev: Use ngrok or similar for testing
JENGA_IPN_URL=

# After payment, the browser is sent back using returnOrigin/returnPath saved
# when checkout started (window.location.origin). Fallbacks: VITE_PUBLIC_APP_URL /
# CORS_ORIGIN (dashboard) and LANDING_PAGE_ORIGINS (storefront). No WEB_APP_URL.

# -----------------------------------------------------------------------------
# IPN Authentication (Required for IPN)
# -----------------------------------------------------------------------------
# Basic Auth credentials for securing your IPN webhook
# Choose strong, unique credentials
JENGA_IPN_USERNAME=
JENGA_IPN_PASSWORD=

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------
# Default payment time limit (if not specified per transaction)
JENGA_PAYMENT_TIME_LIMIT=15mins

# Default product type (if not specified per transaction)
JENGA_DEFAULT_PRODUCT_TYPE=Product

# Default country code (if not specified per transaction)
JENGA_DEFAULT_COUNTRY_CODE=KE

# Default currency (if not specified per transaction)
JENGA_DEFAULT_CURRENCY=KES

# -----------------------------------------------------------------------------
# INSTRUCTIONS
# -----------------------------------------------------------------------------

# 1. GENERATE KEY PAIR
# --------------------
# Run these commands in your terminal:
#
# Generate private key:
# openssl genrsa -out keys/jenga-private-key.pem 2048
#
# Generate public key:
# openssl rsa -in keys/jenga-private-key.pem -outform PEM -pubout -out keys/jenga-public-key.pem
#
# Set proper permissions (Linux/Mac):
# chmod 400 keys/jenga-private-key.pem
#
# IMPORTANT: Add keys/ to .gitignore to prevent committing private key!

# 2. UPLOAD PUBLIC KEY TO JENGA
# ------------------------------
# - Login to https://jengahq.io
# - Navigate to Settings → API Keys
# - Copy the contents of keys/jenga-public-key.pem
# - Paste in the "Public Key" field (without BEGIN/END lines)
# - Save

# 3. CONFIGURE IPN IN JENGAHQ
# ----------------------------
# - Login to https://jengahq.io
# - Navigate to Settings → IPN
# - Click "New IPN"
# - Enter your JENGA_IPN_URL
# - Enter your JENGA_IPN_USERNAME and JENGA_IPN_PASSWORD
# - Choose notification type (All transactions or Success only)
# - Save

# 4. EXAMPLE VALUES
# -----------------
# Here's how your .env might look:
#
# JENGA_ENVIRONMENT=test
# JENGA_MERCHANT_CODE=0582910862
# JENGA_CONSUMER_SECRET=ce0NHpa7ZaxmOFkbEbULABpu412fS4NQa
# JENGA_API_KEY=hbWCSNsk61C24HTwI0q9olFgNGsxNP8jfVhLRo0scR...
# JENGA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JENGA_CALLBACK_URL=http://localhost:3000/api/webhooks/jenga/callback
# JENGA_IPN_URL=https://abc123.ngrok.io/api/webhooks/jenga/ipn
# JENGA_IPN_USERNAME=jenga_ipn_user
# JENGA_IPN_PASSWORD=super_secret_password_here

# 5. SECURITY NOTES
# -----------------
# ✅ DO:
# - Keep credentials in .env file (never commit to git)
# - Use strong, unique passwords for IPN
# - Use HTTPS for all URLs in production
# - Set restrictive permissions on private key (chmod 400)
# - Rotate credentials periodically
# - Use different credentials for test and live
#
# ❌ DON'T:
# - Commit .env file to version control
# - Commit private key to version control
# - Share credentials in Slack/email
# - Use same credentials for test and live
# - Hard-code credentials in source code
# - Use weak passwords for IPN

# 6. TESTING
# ----------
# For local development with IPN:
# - Use ngrok to expose your local server: ngrok http 3000
# - Use the ngrok URL for JENGA_IPN_URL
# - Example: https://abc123.ngrok.io/webhooks/jenga-ipn

# 7. PRODUCTION DEPLOYMENT
# ------------------------
# When going live:
# - Switch JENGA_ENVIRONMENT to "live"
# - Generate new production credentials from Jenga
# - Generate new key pair for production
# - Use HTTPS for all callback URLs
# - Use strong, unique IPN credentials
# - Test with small real transaction first

# =============================================================================
# END OF JENGA CONFIGURATION
# =============================================================================
