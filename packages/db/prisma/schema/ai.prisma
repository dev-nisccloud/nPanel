// AI Chat History Schema

enum AiChatStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

model AiChat {
  id     String       @id @map("_id")
  userId String
  teamId String? // Null if it's a general/personal AI chat not tied to a team
  title  String? // Auto-generated title for the chat
  status AiChatStatus @default(ACTIVE)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // Relations
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages AiChatMessage[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@map("ai_chat")
}

model AiChatMessage {
  id      String  @id @map("_id")
  chatId  String
  role    String // "system", "user", "assistant", "tool"
  content String? @map("content") // Optional if it's a tool call

  // Tool-related fields
  toolCalls  Json? // Array of tool calls if any
  toolCallId String? // ID if this message is a tool response

  // Metadata
  metadata Json? // For tracking tokens, model, etc.

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
  @@index([chatId, createdAt])
  @@map("ai_chat_message")
}
