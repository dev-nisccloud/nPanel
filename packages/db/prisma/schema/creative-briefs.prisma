// Creative Briefs Management System Schema
// Enables creative brief management with status tracking, reference images, and activity logging

// Enums for Creative Briefs
enum CreativeBriefStatus {
  DRAFT // Initial state
  REVIEWING // Under review
  APPROVED // Approved
  REJECTED // Rejected
}

// Main Creative Brief Entity
model CreativeBrief {
  id     String              @id @map("_id")
  name   String // Brief name/title
  userId String // User who created the brief
  teamId String? // Optional team association
  status CreativeBriefStatus @default(DRAFT) // Brief status

  // Brief Content
  background   String // Brief background description
  objectives   String // Brief objectives description
  requirements String // Design requirements
  comments     String? // Additional comments

  // Approval/Rejection Tracking
  approvedBy String? // User who approved
  approvedAt DateTime? // When approved
  rejectedBy String? // User who rejected
  rejectedAt DateTime? // When rejected

  // Timeline (Date Range)
  timelineStartDate DateTime? // Start date of expected delivery
  timelineEndDate   DateTime? // End date of expected delivery

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team?                         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  referenceImages CreativeBriefReferenceImage[]
  activityLogs    CreativeBriefActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@map("creative_brief")
}

// Reference Images for Creative Briefs (UploadThing file metadata)
model CreativeBriefReferenceImage {
  id              String @id @map("_id")
  creativeBriefId String // Parent brief

  // File Storage (UploadThing)
  fileUrl      String // UploadThing file URL
  fileKey      String // UploadThing file key for deletion
  fileName     String // Original file name
  fileSize     Int // File size in bytes
  mimeType     String // File MIME type (should be image/*)
  fileMetadata Json? // Additional metadata (dimensions, etc.)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  creativeBrief CreativeBrief @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)

  @@index([creativeBriefId])
  @@index([createdAt])
  @@map("creative_brief_reference_image")
}

// Activity Logging for Creative Briefs
model CreativeBriefActivityLog {
  id              String   @id @map("_id")
  creativeBriefId String // Brief reference
  userId          String // User who performed action
  action          String // Action type: CREATE, UPDATE, APPROVE, REJECT, DELETE, ADD_REFERENCE_IMAGE, REMOVE_REFERENCE_IMAGE, etc.
  description     String? // Human-readable description
  metadata        Json? // Additional action details
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime

  // Relations
  creativeBrief CreativeBrief @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)

  @@index([creativeBriefId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("creative_brief_activity_log")
}
