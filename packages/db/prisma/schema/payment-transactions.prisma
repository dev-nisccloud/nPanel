// Payment Transactions Schema
// Tracks all payment transactions across different payment gateways
// Supports multiple payment methods: M-Pesa, Stripe, PayPal, etc.

enum PaymentGateway {
  MPESA
  STRIPE
  PAYPAL
  FLUTTERWAVE
  OTHER
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Main payment transaction tracking model
// Stores all payment attempts and their results
model PaymentTransaction {
  id     String  @id @map("_id")
  userId String // User who initiated the payment (required)
  teamId String? // Team associated with the payment (optional, for team payments)

  // Payment Gateway Information
  gateway        PaymentGateway // Payment gateway used (MPESA, STRIPE, etc.)
  gatewayStatus  String? // Gateway-specific status code
  gatewayMessage String? // Gateway-specific status message

  // Transaction Identifiers
  // Gateway-specific identifiers (e.g., CheckoutRequestID for M-Pesa)
  gatewayTransactionId String? // Gateway's transaction ID
  merchantRequestId    String? // Merchant request ID (M-Pesa specific)
  checkoutRequestId    String? // Checkout request ID (M-Pesa specific)
  receiptNumber        String? // Payment receipt number (M-Pesa specific)

  // Payment Details
  amount     String // Amount requested/sent in STK push (preserves precision)
  paidAmount String? // Amount actually paid from callback (if different; e.g. for testing)
  currency   String  @default("KES") // Currency code (KES, USD, etc.)

  // Payment Metadata
  accountReference String? // Account reference (e.g., order number, invoice number)
  transactionDesc  String? // Transaction description
  phoneNumber      String? // Phone number used for payment (M-Pesa specific)

  // Transaction Status
  status PaymentTransactionStatus @default(PENDING)

  // Raw API Responses
  // Store complete raw responses from payment gateway APIs
  rawResponse Json? // Complete raw response from payment gateway (successful)
  rawError    Json? // Complete raw error response from payment gateway (failed)

  // Transaction Lifecycle
  initiatedAt DateTime // When payment was initiated
  processedAt DateTime? // When payment was processed/completed
  failedAt    DateTime? // When payment failed (if applicable)
  refundedAt  DateTime? // When payment was refunded (if applicable)

  // Additional Information
  notes    String? // Additional notes
  metadata Json? // Flexible metadata for transaction-specific data

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  team         Team?                           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs PaymentTransactionActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([gateway])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([checkoutRequestId])
  @@index([merchantRequestId])
  @@index([receiptNumber])
  @@index([accountReference])
  @@index([initiatedAt])
  @@index([processedAt])
  @@index([createdAt])
  @@map("payment_transaction")
}

// Activity logging for payment transaction actions
// Tracks all actions performed on payment transactions
model PaymentTransactionActivityLog {
  id            String             @id @map("_id")
  transactionId String
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  action        String // e.g., "CREATE", "INITIATE", "PROCESS", "SUCCESS", "FAIL", "CANCEL", "REFUND", "UPDATE"
  description   String?
  metadata      Json? // Additional data about the action
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime

  @@index([transactionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("payment_transaction_activity_log")
}
