// Email Builder Design - User templates/designs
model EmailBuilderDesign {
  id           String   @id @map("_id")
  name         String
  description  String?
  userId       String // Creator of the design
  teamId       String? // Optional team ownership
  json         String   @db.Text
  thumbnailUrl String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime
  updatedAt    DateTime

  user         User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs EmailBuilderDesignActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([isPublic])
  @@map("email_builder_design")
}

// Activity logging for Email Builder Design actions
model EmailBuilderDesignActivityLog {
  id                   String             @id @map("_id")
  emailBuilderDesignId String
  emailBuilderDesign   EmailBuilderDesign @relation(fields: [emailBuilderDesignId], references: [id], onDelete: Cascade)
  userId               String
  action               String // e.g., "CREATE", "UPDATE", "DELETE", "DUPLICATE"
  description          String?
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime

  @@index([emailBuilderDesignId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("email_builder_design_activity_log")
}

// Upload library for Email Builder assets (images, files, etc.)
model EmailBuilderLibrary {
  id     String  @id @map("_id")
  userId String // Owner of the asset
  teamId String? // Optional team ownership

  // File Information
  fileName   String
  fileSize   Int // Size in bytes
  mimeType   String
  fileUrl    String // URL to stored file (UploadThing, S3, etc.)
  storageKey String? // Provider-specific storage key

  // Optional metadata
  description String?
  metadata    Json?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
  @@map("email_builder_library")
}
