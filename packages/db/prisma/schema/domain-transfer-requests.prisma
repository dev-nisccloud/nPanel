// Inbound domain transfer requests (before transfer completes and becomes a Domain/subscription).
// Stores details when user initiates transfer from agency UI; provider is called after saving.

enum DomainTransferRequestStatus {
  PENDING // Saved to DB, not yet sent to provider
  SUBMITTED_TO_PROVIDER // Sent to KENIC or OpenProvider
  COMPLETED // Transfer completed (domain may later appear as subscription)
  FAILED // Provider rejected or error
  CANCELLED
}

enum DomainTransferRequestProvider {
  KENIC
  OPENPROVIDER
}

model DomainTransferRequest {
  id         String                        @id @map("_id")
  domainName String // e.g. nisccloud.co.ke
  authCode   String // EPP/auth code from losing registrar
  provider   DomainTransferRequestProvider // KENIC or OPENPROVIDER
  status     DomainTransferRequestStatus   @default(PENDING)

  // Pricing: provider (no margin) and customer (after margin)
  providerPriceAmount   String? // Price from provider, no margin (Kenic: 2100 KES standard)
  providerPriceCurrency String? // e.g. "KES"
  customerPriceAmount   String? // Price after margin (what we charge the customer)
  customerPriceCurrency String? // e.g. "KES"

  // Optional team context
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // When we sent to provider and provider response
  submittedToProviderAt DateTime?
  providerResponse      Json? // Success/error payload from provider

  createdById String
  createdBy   User   @relation("DomainTransferRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime
  updatedAt DateTime

  @@index([domainName])
  @@index([status])
  @@index([createdById])
  @@index([teamId])
  @@index([createdAt])
  @@map("domain_transfer_request")
}
