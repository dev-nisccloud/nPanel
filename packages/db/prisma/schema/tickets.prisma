// Ticket/Support System Schema
// Messaging-style support system between agency and customer users (like WhatsApp)

// Ticket Status
enum TicketStatus {
  OPEN // New ticket, awaiting response
  IN_PROGRESS // Ticket is being worked on
  WAITING // Waiting for customer response
  RESOLVED // Issue resolved, awaiting confirmation
  CLOSED // Ticket closed
  CANCELLED // Ticket cancelled
}

// Ticket Priority
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Ticket Type/Category
enum TicketType {
  TECHNICAL // Technical support
  BILLING // Billing/payment issues
  FEATURE // Feature request
  BUG // Bug report
  ACCOUNT // Account issues
  GENERAL // General inquiry
  HOSTING // Hosting related
  DOMAIN // Domain related
  EMAIL // Email related
  WORDPRESS // WordPress related
}

// Ticket Source
enum TicketSource {
  WEB // Created via web interface
  EMAIL // Created via email
  API // Created via API
  CHAT // Created via chat widget
  PHONE // Created via phone call
}

// Message Read Status
enum MessageReadStatus {
  SENT // Message sent
  DELIVERED // Message delivered
  READ // Message read
}

// Main Ticket Entity (Represents a conversation)
model Ticket {
  id           String @id @map("_id")
  ticketNumber String @unique // Human-readable ticket number (e.g., TKT-2024-001)

  // Basic Information
  subject     String? // Optional ticket subject/title (can be auto-generated from first message)
  description String? // Optional initial description (can be first message)

  // Classification
  type     TicketType     @default(GENERAL)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)
  source   TicketSource   @default(WEB)

  // Relationships
  createdById  String // User who created the ticket (customer or agency)
  teamId       String? // Team associated with ticket (if customer created)
  assignedToId String? // Agency user assigned to handle ticket

  // Messaging metadata
  lastMessageId       String? // ID of the last message in the conversation
  lastMessageAt       DateTime? // When last message was sent
  lastMessagePreview  String? // Preview of last message (for chat list)
  unreadCount         Int       @default(0) // Unread message count for assigned agent
  customerUnreadCount Int       @default(0) // Unread message count for customer

  // Metadata
  metadata      Json? // Additional metadata (related order ID, service ID, etc.)
  internalNotes String? // Internal notes visible only to agency users

  // Timestamps
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  resolvedAt             DateTime? // When ticket was resolved
  closedAt               DateTime? // When ticket was closed
  firstResponseAt        DateTime? // When first response was sent
  lastResponseAt         DateTime? // When last response was sent
  lastCustomerResponseAt DateTime? // When customer last responded
  lastAgentResponseAt    DateTime? // When agent last responded

  // Relations
  createdBy    User                @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  attachments  TicketAttachment[]
  tags         TicketTagRelation[]
  activityLogs TicketActivityLog[]

  @@index([createdById])
  @@index([teamId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([status, priority]) // Composite for filtering
  @@index([teamId, status]) // Composite for team tickets
  @@index([assignedToId, status]) // Composite for agent tickets
  @@map("ticket")
}

// Ticket Messages (Simple messaging, no threading)
model TicketMessage {
  id       String @id @map("_id")
  ticketId String
  senderId String // User who sent the message

  // Content
  content    String // Message content
  isInternal Boolean @default(false) // Internal message (visible only to agency)
  isSystem   Boolean @default(false) // System-generated message (status changes, etc.)

  // Read status
  readStatus MessageReadStatus @default(SENT)
  readAt     DateTime? // When message was read

  // Metadata
  metadata Json? // Additional metadata (edited, deleted, etc.)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime? // When message was last edited
  deletedAt DateTime? // Soft delete timestamp

  // Relations
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User               @relation("TicketMessages", fields: [senderId], references: [id], onDelete: Restrict)
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@index([ticketId, createdAt]) // Composite for ordered messages
  @@index([isInternal])
  @@index([deletedAt])
  @@index([readStatus])
  @@map("ticket_message")
}

// Ticket Attachments (Attached to messages)
model TicketAttachment {
  id           String  @id @map("_id")
  ticketId     String?
  messageId    String? // Attached to a specific message
  uploadedById String

  // File Information
  fileName   String
  fileSize   Int // Size in bytes
  mimeType   String
  fileUrl    String // URL to stored file
  storageKey String? // Storage key (S3, etc.)

  // Metadata
  description String?
  metadata    Json?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("TicketAttachments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("ticket_attachment")
}

// Ticket Tags (for categorization)
model TicketTag {
  id          String   @id @map("_id")
  name        String   @unique
  color       String? // Hex color for UI
  description String?
  createdAt   DateTime
  updatedAt   DateTime

  // Relations
  tickets TicketTagRelation[]

  @@index([name])
  @@map("ticket_tag")
}

// Ticket-Tag Relation (Many-to-Many)
model TicketTagRelation {
  id        String   @id @map("_id")
  ticketId  String
  tagId     String
  addedById String?
  addedAt   DateTime

  // Relations
  ticket Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tagId])
  @@index([ticketId])
  @@index([tagId])
  @@map("ticket_tag_relation")
}

// Ticket Activity Log (Track all changes)
model TicketActivityLog {
  id       String  @id @map("_id")
  ticketId String
  userId   String? // User who performed action (null for system actions)

  // Action Details
  action      String // CREATE, UPDATE, STATUS_CHANGE, ASSIGN, MESSAGE, ATTACH, TAG_ADD, TAG_REMOVE, etc.
  description String? // Human-readable description
  oldValue    Json? // Previous value (for updates)
  newValue    Json? // New value (for updates)
  metadata    Json? // Additional action details

  // Request Metadata
  ipAddress String?
  userAgent String?

  // Timestamps
  createdAt DateTime

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ticketId, createdAt]) // Composite for ticket timeline
  @@map("ticket_activity_log")
}
