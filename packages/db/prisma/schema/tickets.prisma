// Ticket/Support System Schema
// Enables comprehensive ticket system between agency and customer users with full threading

// Ticket Status
enum TicketStatus {
  OPEN // New ticket, awaiting response
  IN_PROGRESS // Ticket is being worked on
  WAITING // Waiting for customer response
  RESOLVED // Issue resolved, awaiting confirmation
  CLOSED // Ticket closed
  CANCELLED // Ticket cancelled
}

// Ticket Priority
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Ticket Type/Category
enum TicketType {
  TECHNICAL // Technical support
  BILLING // Billing/payment issues
  FEATURE // Feature request
  BUG // Bug report
  ACCOUNT // Account issues
  GENERAL // General inquiry
  HOSTING // Hosting related
  DOMAIN // Domain related
  EMAIL // Email related
  WORDPRESS // WordPress related
}

// Ticket Source
enum TicketSource {
  WEB // Created via web interface
  EMAIL // Created via email
  API // Created via API
  CHAT // Created via chat widget
  PHONE // Created via phone call
}

// Main Ticket Entity
model Ticket {
  id           String @id @map("_id")
  ticketNumber String @unique // Human-readable ticket number (e.g., TKT-2024-001)

  // Basic Information
  subject     String // Ticket subject/title
  description String // Initial ticket description

  // Classification
  type     TicketType     @default(GENERAL)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)
  source   TicketSource   @default(WEB)

  // Relationships
  createdById  String // User who created the ticket (can be customer or agency)
  teamId       String? // Team associated with ticket (if customer created)
  assignedToId String? // Agency user assigned to handle ticket

  // Metadata
  metadata      Json? // Additional metadata (related order ID, service ID, etc.)
  internalNotes String? // Internal notes visible only to agency users

  // Timestamps
  createdAt              DateTime
  updatedAt              DateTime
  resolvedAt             DateTime? // When ticket was resolved
  closedAt               DateTime? // When ticket was closed
  firstResponseAt        DateTime? // When first response was sent
  lastResponseAt         DateTime? // When last response was sent
  lastCustomerResponseAt DateTime? // When customer last responded
  lastAgentResponseAt    DateTime? // When agent last responded

  // Relations
  createdBy    User                @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments     TicketComment[]
  participants TicketParticipant[]
  attachments  TicketAttachment[]
  tags         TicketTagRelation[]
  activityLogs TicketActivityLog[]

  @@index([createdById])
  @@index([teamId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([status, priority]) // Composite for filtering
  @@index([teamId, status]) // Composite for team tickets
  @@map("ticket")
}

// Ticket Comments/Replies (Threaded)
model TicketComment {
  id       String  @id @map("_id")
  ticketId String
  parentId String? // For threading - references another TicketComment
  authorId String // User who wrote the comment

  // Content
  content    String // Comment content (supports markdown)
  isInternal Boolean @default(false) // Internal comment (visible only to agency)
  isSystem   Boolean @default(false) // System-generated comment (status changes, etc.)

  // Metadata
  metadata Json? // Additional metadata (edited, deleted, etc.)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime
  editedAt  DateTime? // When comment was last edited
  deletedAt DateTime? // Soft delete timestamp

  // Relations
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation("TicketComments", fields: [authorId], references: [id], onDelete: Restrict)
  parent      TicketComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     TicketComment[]    @relation("CommentReplies")
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([parentId])
  @@index([authorId])
  @@index([createdAt])
  @@index([ticketId, createdAt]) // Composite for ordered comments
  @@index([isInternal])
  @@index([deletedAt])
  @@map("ticket_comment")
}

// Ticket Participants (Track who's involved)
model TicketParticipant {
  id        String   @id @map("_id")
  ticketId  String
  userId    String
  role      String // "CREATOR", "ASSIGNEE", "WATCHER", "CC"
  addedById String? // Who added this participant
  addedAt   DateTime

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation("TicketParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId, role])
  @@index([ticketId])
  @@index([userId])
  @@index([role])
  @@map("ticket_participant")
}

// Ticket Attachments
model TicketAttachment {
  id           String  @id @map("_id")
  ticketId     String?
  commentId    String?
  uploadedById String

  // File Information
  fileName   String
  fileSize   Int // Size in bytes
  mimeType   String
  fileUrl    String // URL to stored file
  storageKey String? // Storage key (S3, etc.)

  // Metadata
  description String?
  metadata    Json?

  // Timestamps
  createdAt DateTime

  // Relations
  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("TicketAttachments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([commentId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("ticket_attachment")
}

// Ticket Tags (for categorization)
model TicketTag {
  id          String   @id @map("_id")
  name        String   @unique
  color       String? // Hex color for UI
  description String?
  createdAt   DateTime
  updatedAt   DateTime

  // Relations
  tickets TicketTagRelation[]

  @@index([name])
  @@map("ticket_tag")
}

// Ticket-Tag Relation (Many-to-Many)
model TicketTagRelation {
  id        String   @id @map("_id")
  ticketId  String
  tagId     String
  addedById String?
  addedAt   DateTime

  // Relations
  ticket Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tagId])
  @@index([ticketId])
  @@index([tagId])
  @@map("ticket_tag_relation")
}

// Ticket Activity Log (Track all changes)
model TicketActivityLog {
  id       String  @id @map("_id")
  ticketId String
  userId   String? // User who performed action (null for system actions)

  // Action Details
  action      String // CREATE, UPDATE, STATUS_CHANGE, ASSIGN, COMMENT, ATTACH, TAG_ADD, TAG_REMOVE, etc.
  description String? // Human-readable description
  oldValue    Json? // Previous value (for updates)
  newValue    Json? // New value (for updates)
  metadata    Json? // Additional action details

  // Request Metadata
  ipAddress String?
  userAgent String?

  // Timestamps
  createdAt DateTime

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ticketId, createdAt]) // Composite for ticket timeline
  @@map("ticket_activity_log")
}
