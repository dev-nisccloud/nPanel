// SEO Reports Schema
// Manual data entry for monthly SEO reports; numeric metrics stored as String.
// Slimmed-down model: report name, period, recommendations, and core metrics only.

enum SeoReportStatus {
  DRAFT
  FINAL
}

// Main SEO Report Entity
model SeoReport {
  id     String  @id @map("_id")
  userId String // User who created/uploaded the report (required)
  teamId String? // Optional team association

  // Report identity & period
  reportName  String  @default("") // SEO report name (default for migration; backfill from websiteUrl if needed)
  reportMonth String // 1-12
  reportYear  String // e.g. "2025"
  websiteUrl  String? // Optional: site the report covers (e.g. example.com)

  status          SeoReportStatus @default(DRAFT)
  recommendations String?

  // Core metrics (all numeric as String)
  sessions        String?
  totalWebTraffic String?
  totalViews      String?
  bounceRate      String?
  users           String?
  returningUsers  String?
  eventCount      String?
  conversions     String?
  sessionDuration String?
  engagedSessions String?
  sessionsDesktop String?
  sessionsMobile  String?
  sessionsTablet  String?
  formSubmissions String?
  impressions     String?
  clicks          String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs SeoReportActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([reportYear, reportMonth])
  @@index([reportName])
  @@index([status])
  @@index([createdAt])
  @@index([teamId, reportYear, reportMonth])
  @@map("seo_report")
}

// Activity logging for SEO report actions
model SeoReportActivityLog {
  id          String   @id @map("_id")
  seoReportId String
  userId      String // User who performed action
  action      String // e.g. CREATE, UPDATE, DELETE, ADD_TOP_PAGE, REMOVE_TOP_PAGE, STATUS_CHANGE
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  // Relations
  seoReport SeoReport @relation(fields: [seoReportId], references: [id], onDelete: Cascade)

  @@index([seoReportId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("seo_report_activity_log")
}
