// Independent Reporting Models

model SalesReportSnapshot {
  id              String   @id @default(cuid())
  date            DateTime // Date of the snapshot (e.g., start of day or month)
  period          String   // "DAILY", "MONTHLY"
  totalRevenue    Decimal  @default(0) @db.Decimal(20, 2)
  totalInvoiced   Decimal  @default(0) @db.Decimal(20, 2)
  totalPaid       Decimal  @default(0) @db.Decimal(20, 2)
  taxableAmount   Decimal  @default(0) @db.Decimal(20, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(20, 2)
  pendingAmount   Decimal  @default(0) @db.Decimal(20, 2)
  invoiceCount    Int      @default(0)
  paidInvoiceCount Int      @default(0)
  currency        String   @default("KES")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, period, currency])
  @@index([date, period])
}

model RevenueByServiceSnapshot {
  id              String   @id @default(cuid())
  date            DateTime
  period          String   // "DAILY", "MONTHLY"
  serviceType     String   // e.g., "HOSTING", "SEO", "CREATIVE"
  amount          Decimal  @default(0) @db.Decimal(20, 2)
  currency        String   @default("KES")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, period, serviceType, currency])
  @@index([date, period, serviceType])
}

model CreativeProductionSnapshot {
  id              String   @id @default(cuid())
  date            DateTime
  period          String   // "DAILY", "MONTHLY"
  assetsCreated   Int      @default(0)
  assetsApproved  Int      @default(0)
  versionsCreated Int      @default(0)
  avgVelocityDays Float?   // Average time to approval
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, period])
  @@index([date, period])
}
