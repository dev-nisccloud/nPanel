  name                         String
  email                        String
  emailVerified                Boolean                       @default(false)
  image                        String?
  role                         UserRole                      @default(CUSTOMER)
  status                       UserStatus                    @default(ACTIVE)
  lastAccessedTeamId           String?
  lastLoginAt                  DateTime?
  createdAt                    DateTime
  updatedAt                    DateTime
  sessions                     Session[]
  accounts                     Account[]
  teamMemberships              TeamMember[]
  profile                      UserProfile?
  customerIntegrations         CustomerIntegration[]
  domains                      Domain[]
  activityLogs                 UserActivityLog[]
  // Social Media Marketing Relations
  socialMediaIntegrations      SocialMediaIntegration[]
  socialMediaPageTokens        SocialMediaPageToken[]
  metaContentCalendarPosts     MetaContentCalendar[]
  LinkedInContentCalendar      LinkedInContentCalendar[]
  // Google Ads Relations
  googleAdsIntegrations        GoogleAdsIntegration[]
  // Meta Ads Relations (via activity logs - accounts are linked to integrations)
  metaAdsAccountActivityLogs   MetaAdsAccountActivityLog[]
  metaAdsCampaignActivityLogs  MetaAdsCampaignActivityLog[]
  metaAdsAdSetActivityLogs     MetaAdsAdSetActivityLog[]
  metaAdsAdActivityLogs        MetaAdsAdActivityLog[]
