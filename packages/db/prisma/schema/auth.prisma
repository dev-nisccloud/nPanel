// Core domain registration information
model DomainRegistration {
  id                    String        @id @map("_id")
  domainName            String        @unique
  teamId                String?
  registeredBy          String?       // User ID who registered the domain
  
  // OpenProvider Integration Fields
  openProviderId        Int?          // OpenProvider domain ID
  operation             DomainOperation @default(REGISTRATION) // REGISTRATION, TRANSFER, etc.
  authCode              String?       // Auth code for transfers
  activationDate        DateTime?     // OpenProvider activation date
  expirationDate        DateTime?     // OpenProvider expiration date
  renewalDate           DateTime?     // OpenProvider renewal date
  
  // Contact Handles (OpenProvider)
  ownerHandle           String?       // OpenProvider owner contact handle
  adminHandle           String?       // OpenProvider admin contact handle
  techHandle            String?       // OpenProvider tech contact handle
  billingHandle         String?       // OpenProvider billing contact handle
  resellerHandle        String?       // OpenProvider reseller contact handle
  
  // Domain Details
  registrationDate      DateTime?     // When domain was first registered
  expiryDate            DateTime?     // Current expiry date
  nextRenewalDate       DateTime?     // When next renewal is due
  renewalCycle          DomainCycle   @default(ANNUAL)
  period                Int?          // Registration period (1 = 1 year, etc.)
  status                DomainStatus  @default(PENDING)
  
  // Pricing information - OpenProvider (provider) vs NISC (selling) prices
  openProviderPrice     String?       // Price from OpenProvider for registration
  openProviderCurrency  String?       @default("USD") // OpenProvider currency
  niscPrice             String?       // Price we sold it for
  niscCurrency          String?       @default("KES") // Our selling currency
  
  // Invoice tracking
  invoiceNumber         String?       // Invoice number for this registration
  
  // Customer Integration
  customerIntegrationId String?       // Reference to customer integration (OpenProvider)
  
  // TLD settings reference
  tldSettingId         String?
  
  // Nameserver Management
  nameserverGroupId String?       // Reference to nameserver group
  dnsRecords        Json?         // DNS records as JSON
  autoRenew         String?       // "on", "off", "default" - OpenProvider format
  
  // Transfer specific fields
  transferRequestedAt   DateTime?     // When transfer was requested
  transferCompletedAt   DateTime?     // When transfer was completed
  previousRegistrar     String?       // Previous registrar for transfers
  
  // Timestamps
  createdAt             DateTime
  updatedAt             DateTime
  
  // Relations
  team                  Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  nameserverGroup       NameserverGroup? @relation(fields: [nameserverGroupId], references: [id], onDelete: SetNull)
  renewals              DomainRenewal[]
  transfers             DomainTransfer[]
  hostingSubscriptions  HostingSubscription[]
  orders                Order[]
  customerIntegration   CustomerIntegration? @relation(fields: [customerIntegrationId], references: [id], onDelete: SetNull)
  activityLogs          DomainRegistrationActivityLog[]
  
  @@index([domainName])
  @@index([teamId])
  @@index([nameserverGroupId])
  @@index([status])
  @@index([expiryDate])
  @@index([nextRenewalDate])
  @@index([registeredBy])
  @@index([openProviderId])
  @@index([operation])
  @@map("domain_registration")
}

// Individual renewal records
model DomainRenewal {
  id                    String        @id @map("_id")
  domainRegistrationId  String
  renewedBy             String?       // User ID who renewed the domain
  renewalDate           DateTime      // When renewal was processed
  expiryDate            DateTime      // New expiry date after renewal
  renewalCycle          DomainCycle   // Cycle for this renewal
  status                DomainStatus  @default(ACTIVE)
  
  // Pricing information - OpenProvider (provider) vs NISC (selling) prices
  openProviderPrice     String        // Price from OpenProvider for renewal
  openProviderCurrency  String        @default("USD") // OpenProvider currency
  niscPrice             String        // Price we sold renewal for
  niscCurrency          String        @default("KES") // Our selling currency
  
  // Additional renewal info
  invoiceNumber         String?       // Invoice number for this renewal
  notes                 String?       // Additional notes
  
  // Timestamps
  createdAt             DateTime
  updatedAt             DateTime
  
  // Relations
  domainRegistration    DomainRegistration @relation(fields: [domainRegistrationId], references: [id], onDelete: Cascade)
  orders               Order[]
  activityLogs          DomainRenewalActivityLog[]
  
  @@index([domainRegistrationId])
  @@index([renewalDate])
  @@index([expiryDate])
  @@index([renewedBy])
  @@map("domain_renewal")
}

// Domain transfer tracking
model DomainTransfer {
  id                    String        @id @map("_id")
  domainRegistrationId  String
  transferredBy         String?       // User ID who initiated transfer
  authCode              String        // Auth code for transfer
  status                DomainStatus  @default(PENDING_TRANSFER)
  
  // Transfer details
  transferRequestedAt   DateTime      // When transfer was requested
  transferCompletedAt   DateTime?     // When transfer was completed
  previousRegistrar     String?       // Previous registrar
  previousExpiryDate     DateTime?    // Expiry date at previous registrar
  
  // Contact handles for transfer
  ownerHandle           String?       // Owner contact handle
  adminHandle           String?       // Admin contact handle
  techHandle            String?       // Tech contact handle
  billingHandle         String?       // Billing contact handle
  
  // Nameservers for transfer
  nameserverGroupId String?       // Reference to nameserver group
  autoRenew         String?       // "on", "off", "default"
  
  // Pricing information
  openProviderPrice     String?       // Price from OpenProvider for transfer
  openProviderCurrency  String?       @default("USD")
  niscPrice             String?       // Price we charged for transfer
  niscCurrency          String?       @default("KES")
  
  // Invoice tracking
  invoiceNumber         String?       // Invoice number for this transfer
  
  // Additional info
  notes                 String?       // Additional notes
  failureReason         String?       // Reason if transfer failed
  
  // Timestamps
  createdAt             DateTime
  updatedAt             DateTime
  
  // Relations
  domainRegistration    DomainRegistration @relation(fields: [domainRegistrationId], references: [id], onDelete: Cascade)
  nameserverGroup       NameserverGroup? @relation(fields: [nameserverGroupId], references: [id], onDelete: SetNull)
  orders               Order[]
  activityLogs          DomainTransferActivityLog[]
  
  @@index([domainRegistrationId])
  @@index([nameserverGroupId])
  @@index([status])
  @@index([transferRequestedAt])
  @@index([transferredBy])
  @@map("domain_transfer")
}

// Activity logging for domain registration actions
model DomainRegistrationActivityLog {
  id                    String        @id @map("_id")
  userId                String
  domainRegistrationId  String
  domainRegistration    DomainRegistration @relation(fields: [domainRegistrationId], references: [id], onDelete: Cascade)
  action                String        // e.g., "REGISTER", "UPDATE", "SUSPEND", "TRANSFER", "DELETE"
  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([domainRegistrationId])
  @@index([action])
  @@index([createdAt])
  @@map("domain_registration_activity_log")
}

// Activity logging for domain renewal actions
model DomainRenewalActivityLog {
  id                    String        @id @map("_id")
  userId                String
  domainRenewalId       String
  domainRenewal         DomainRenewal @relation(fields: [domainRenewalId], references: [id], onDelete: Cascade)
  action                String        // e.g., "RENEW", "CANCEL", "REFUND", "UPDATE"
  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([domainRenewalId])
  @@index([action])
  @@index([createdAt])
  @@map("domain_renewal_activity_log")
}

// Activity logging for domain transfer actions
model DomainTransferActivityLog {
  id                    String        @id @map("_id")
  userId                String
  domainTransferId      String
  domainTransfer        DomainTransfer @relation(fields: [domainTransferId], references: [id], onDelete: Cascade)
  action                String        // e.g., "TRANSFER_INITIATE", "TRANSFER_COMPLETE", "TRANSFER_FAIL", "CANCEL"
  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([domainTransferId])
  @@index([action])
  @@index([createdAt])
  @@map("domain_transfer_activity_log")
}

