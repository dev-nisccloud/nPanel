  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([hostingPlanId])
  @@index([action])
  @@index([createdAt])
  @@map("hosting_plan_activity_log")
}

// Activity logging for hosting subscription actions
