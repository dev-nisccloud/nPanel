model TeamMember {
  id        String   @id @map("_id")
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime
  updatedAt DateTime
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

model TeamInvite {
  id          String       @id @map("_id")
  code        String       @unique
  teamId      String
  email       String
  role        TeamRole     @default(MEMBER)
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([code])
  @@index([teamId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("team_invite")
}

model TeamBillingSettings {
  id              String   @id @map("_id")
  teamId          String   @unique
  legalName       String
  billingEmail    String
  billingPhone    String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?
  country         String
  postalCode      String?
  taxId           String?
  additionalNotes String?
  updatedBy       String
  createdAt       DateTime
  updatedAt       DateTime

  team         Team                             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activityLogs TeamBillingSettingsActivityLog[]

  @@index([teamId])
  @@map("team_billing_settings")
}

model TeamBillingSettingsActivityLog {
  id                    String   @id @map("_id")
  teamBillingSettingsId String
  userId                String
  action                String
  description           String?
  metadata              Json?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime

  teamBillingSettings TeamBillingSettings @relation(fields: [teamBillingSettingsId], references: [id], onDelete: Cascade)

  @@index([teamBillingSettingsId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("team_billing_settings_activity_log")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Extended user profile information
model UserProfile {
  id         String   @id @map("_id")
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String?
  lastName   String?
  phone      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  createdAt  DateTime
  updatedAt  DateTime

  @@index([userId])
  @@map("user_profile")
}

// Activity logging for user actions and status changes
model UserActivityLog {
  id          String   @id @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String // e.g., "LOGIN", "LOGOUT", "STATUS_CHANGE", "ROLE_CHANGE", "TEAM_JOIN", "TEAM_LEAVE"
  description String?
  metadata    Json? // Additional data about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_activity_log")
}

// Hosting plan templates/definitions
model HostingPlan {
  id          String      @id @map("_id")
  name        String // Plan name (e.g., "Basic Web Hosting", "Email Only")
  description String? // Plan description
  hostingType HostingType // Type of hosting service

  // Plesk Integration
  pleskServicePlanId String? // Plesk service plan ID
  pleskFilterId      String? // Plesk filter ID for provisioning
  pleskIpAddress     String? // IP address for this plan type

  // Marketing Features (for landing pages)
  features      String[] // Array of marketing features (e.g., ["Unlimited Email", "SSL Certificate", "24/7 Support"])
  highlights    String[] // Array of key highlights (e.g., ["Best Value", "Most Popular", "Enterprise Grade"])
  isPopular     Boolean  @default(false) // Mark as popular plan
  isRecommended Boolean  @default(false) // Mark as recommended plan

  // Pricing
  niscPrice    String? // Our selling price
  niscCurrency String? @default("KES")

  // Billing
  billingCycle BillingCycle @default(MONTHLY)
  setupFee     String? // One-time setup fee

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  subscriptions HostingSubscription[]
  promos        Promo[]
  activityLogs  HostingPlanActivityLog[]

  @@index([hostingType])
  @@index([isActive])
  @@map("hosting_plan")
}

// NISC Service Plan - Generic service plan model supporting all service types
model NiscServicePlan {
  id             String              @id @map("_id")
  name           String // Plan name (e.g., "Basic Web Hosting", "SEO Starter Package")
  description    String? // Plan description
  planType       NiscServicePlanType // Type of service plan
  hostingSubType HostingType? // Sub-type for HOSTING plans (null for other types)

  // Plesk Integration (only for HOSTING plans)
  pleskServicePlanId String? // Plesk service plan ID
  pleskFilterId      String? // Plesk filter ID for provisioning
  pleskIpAddress     String? // IP address for this plan type

  // Marketing Features (for landing pages)
  features      String[] // Array of marketing features (e.g., ["Unlimited Email", "SSL Certificate", "24/7 Support"])
  highlights    String[] // Array of key highlights (e.g., ["Best Value", "Most Popular", "Enterprise Grade"])
  isPopular     Boolean  @default(false) // Mark as popular plan
  isRecommended Boolean  @default(false) // Mark as recommended plan

  // Pricing
  niscPrice    String? // Our selling price
  niscCurrency String? @default("KES")

  // Billing
  billingCycle BillingCycle @default(MONTHLY)
  setupFee     String? // One-time setup fee

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  activityLogs         NiscServicePlanActivityLog[]
  OrderItem            OrderItem[]
  serviceSubscriptions ServiceSubscription[]

  @@index([planType])
  @@index([hostingSubType])
  @@index([isActive])
  @@index([isDefault])
  @@map("nisc_service_plan")
}

// Activity logging for NISC service plan actions
model NiscServicePlanActivityLog {
  id                String          @id @map("_id")
  userId            String
  niscServicePlanId String
  niscServicePlan   NiscServicePlan @relation(fields: [niscServicePlanId], references: [id], onDelete: Cascade)
  action            String // e.g., "CREATE", "UPDATE", "DELETE", "ACTIVATE", "DEACTIVATE"
  description       String?
  metadata          Json? // Additional data about the action
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime

  @@index([userId])
  @@index([niscServicePlanId])
  @@index([action])
  @@index([createdAt])
  @@map("nisc_service_plan_activity_log")
}

// Hosting subscription instances
model HostingSubscription {
  id            String  @id @map("_id")
  hostingPlanId String // Reference to hosting plan
  teamId        String? // Team that owns this subscription
  provisionedBy String? // User ID who provisioned this service

  // Plesk Integration
  pleskFilterId  String  @unique // Critical for Plesk communication
  pleskOwnerId   String? // Plesk owner ID
  pleskServiceId String? // Plesk service ID

  // Plesk Subscription Fields (from API)
  pleskName             String? // Subscription name in Plesk
  pleskStatus           Int? // Plesk status (0=active, etc.)
  pleskDescription      String? // Description in Plesk
  pleskAdminDescription String? // Admin description

  // Auto-generated Plesk credentials
  pleskFtpLogin    String? // Auto-generated FTP login
  pleskFtpPassword String? // Auto-generated FTP password

  // Domain Integration
  primaryDomain String? // Primary domain for this hosting
  domainId      String? // Reference to domain

  // Service Details
  operation          HostingOperation   @default(PROVISION)
  provisioningMethod ProvisioningMethod @default(AUTOMATIC) // How it was provisioned
  status             HostingStatus      @default(PENDING)
  hostingType        HostingType // Type of hosting

  // Billing Information
  billingCycle    BillingCycle @default(MONTHLY)
  nextRenewalDate DateTime? // When next renewal is due
  expiryDate      DateTime? // When subscription expires

  // Pricing Information
  niscPrice    String? // Price we charged
  niscCurrency String? @default("KES")

  // Invoice tracking
  invoiceNumber String? // Invoice number for this subscription

  // Customer Integration
  customerIntegrationId String? // Reference to customer integration (Plesk)

  // Additional Info
  notes     String? // Additional notes
  autoRenew Boolean @default(true)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  hostingPlan         HostingPlan                      @relation(fields: [hostingPlanId], references: [id], onDelete: Restrict)
  team                Team?                            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  domain              Domain?                          @relation(fields: [domainId], references: [id], onDelete: SetNull)
  renewals            HostingRenewal[]
  orders              Order[]
  orderItems          OrderItem[] // Order items that reference this subscription
  customerIntegration CustomerIntegration?             @relation(fields: [customerIntegrationId], references: [id], onDelete: SetNull)
  wordpressInstances  WordPressInstance[]
  activityLogs        HostingSubscriptionActivityLog[]
  serviceSubscription ServiceSubscription? // Link to service subscription for billing tracking

  @@index([hostingPlanId])
  @@index([teamId])
  @@index([pleskFilterId])
  @@index([status])
  @@index([nextRenewalDate])
  @@index([expiryDate])
  @@index([primaryDomain])
  @@map("hosting_subscription")
}

// Individual hosting renewal records
model HostingRenewal {
  id                    String        @id @map("_id")
  hostingSubscriptionId String
  renewedBy             String? // User ID who renewed the hosting
  renewalDate           DateTime // When renewal was processed
  expiryDate            DateTime // New expiry date after renewal
  billingCycle          BillingCycle // Cycle for this renewal
  status                HostingStatus @default(ACTIVE)

  // Pricing information
  niscPrice    String? // Price we charged for renewal
  niscCurrency String? @default("KES")

  // Invoice tracking
  invoiceNumber String? // Invoice number for this renewal

  // Additional info
  notes String? // Additional notes

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  hostingSubscription HostingSubscription         @relation(fields: [hostingSubscriptionId], references: [id], onDelete: Cascade)
  orders              Order[]
  activityLogs        HostingRenewalActivityLog[]

  @@index([hostingSubscriptionId])
  @@index([renewalDate])
  @@index([expiryDate])
  @@index([renewedBy])
  @@map("hosting_renewal")
}

