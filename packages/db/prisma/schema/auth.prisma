// Activity logging for domain transfer actions
model DomainTransferActivityLog {
  id               String         @id @map("_id")
  userId           String
  domainTransferId String
  teamId           String? // Optional team context
  domainTransfer   DomainTransfer @relation(fields: [domainTransferId], references: [id], onDelete: Cascade)
  action           String // e.g., "TRANSFER_INITIATE", "TRANSFER_COMPLETE", "TRANSFER_FAIL", "CANCEL"
  description      String?
  metadata         Json? // Additional data about the action
