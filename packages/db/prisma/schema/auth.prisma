// Domain information - stores domains registered via OpenProvider
model Domain {
  id             String  @id @map("_id")
  domainName     String  @unique
  userId         String // User ID who made this record (not the registrant)
  teamId         String? // Optional team association
  openProviderId Int // OpenProvider domain ID (required, always provided by OpenProvider)

  // Dates
  activationDate   DateTime? // OpenProvider activation date
  expirationDate   DateTime? // OpenProvider expiration date
  renewalDate      DateTime? // OpenProvider renewal date
  registrationDate DateTime // When domain was first registered

  // Pricing information (KES only, no currency field needed)
  openProviderPrice String? // Price from OpenProvider in KES
  niscPrice         String? // Price we sold it for in KES

  // Notes
  notes String? // Additional notes

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  renewals              DomainRenewal[]
  transfers             DomainTransfer[]
  hostingSubscriptions  HostingSubscription[]
  orders                Order[]
  activityLogs          DomainActivityLog[]
  CustomerIntegration   CustomerIntegration?  @relation(fields: [customerIntegrationId], references: [id])
  customerIntegrationId String?
  NameserverGroup       NameserverGroup?      @relation(fields: [nameserverGroupId], references: [id])
  nameserverGroupId     String?

  @@index([domainName])
  @@index([userId])
  @@index([teamId])
  @@index([openProviderId])
  @@index([registrationDate])
  @@index([expirationDate])
  @@map("domain")
}

// Individual renewal records - tracks renewal history independently
model DomainRenewal {
  id          String   @id @map("_id")
  domainId    String   @unique // Reference to domain (unique - one renewal record per domain)
  renewedBy   String // User ID who renewed the domain (creator of this record)
  renewalDate DateTime // When renewal was processed

  // Optional team link
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Pricing information (KES only, no currency field needed)
  openProviderPrice String? // Price from OpenProvider in KES
  niscPrice         String? // Price we sold renewal for in KES

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  domain        Domain                     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  renewedByUser User                       @relation("DomainRenewalCreatedBy", fields: [renewedBy], references: [id], onDelete: Restrict)
  orders        Order[]
  activityLogs  DomainRenewalActivityLog[]

  @@index([domainId])
  @@index([renewalDate])
  @@index([renewedBy])
  @@index([teamId])
  @@map("domain_renewal")
}

// Domain transfer tracking
model DomainTransfer {
  id            String       @id @map("_id")
  domainId      String // Reference to domain
  createdById   String // User ID who created this record
  transferredBy String? // User ID who initiated transfer (if different from creator)
  authCode      String // Auth code for transfer
  status        DomainStatus @default(PENDING_TRANSFER)

  // Optional team link
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Transfer details
  transferRequestedAt DateTime // When transfer was requested
  transferCompletedAt DateTime? // When transfer was completed

  // Pricing information (KES only, no currency field needed)
  openProviderPrice String? // Price from OpenProvider in KES
  niscPrice         String? // Price we charged for transfer in KES

  // Additional info
  notes String? // Additional notes

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  domain            Domain                      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdBy         User                        @relation("DomainTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orders            Order[]
  activityLogs      DomainTransferActivityLog[]
  NameserverGroup   NameserverGroup?            @relation(fields: [nameserverGroupId], references: [id])
  nameserverGroupId String?

  @@index([domainId])
  @@index([status])
  @@index([transferRequestedAt])
  @@index([transferredBy])
  @@index([createdById])
  @@index([teamId])
  @@map("domain_transfer")
}

// Activity logging for domain actions
model DomainActivityLog {
  id          String   @id @map("_id")
  userId      String
  domainId    String
  teamId      String? // Optional team context
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
