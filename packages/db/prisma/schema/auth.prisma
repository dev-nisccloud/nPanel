  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([customerIntegrationId])
  @@index([action])
  @@index([createdAt])
  @@map("customer_integration_activity_log")
