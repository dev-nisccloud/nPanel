// User role for customer vs agency/admin distinction
enum UserRole {
  CUSTOMER
  AGENCY_ADMIN
  AGENCY_SUPER_ADMIN
  AGENCY_USER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum BillingCycle {
  YEARLY
  MONTHLY
  BIENNIALLY
  CUSTOM
}

enum HostingStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  PENDING
  PROCESSING
  FAILED
  EXPIRED
}

enum HostingType {
  WEB_HOSTING // Full web hosting with databases, FTP, etc.
  EMAIL_HOSTING // Email-only hosting without database access
  RESELLER_HOSTING // Reseller hosting plans
  VPS_HOSTING // VPS hosting plans
  DEDICATED_HOSTING // Dedicated server hosting
}

// NISC Service Plan Types - All service types offered by NISC
enum NiscServicePlanType {
  HOSTING // Hosting services (web, email, reseller, VPS, dedicated)
  SEO // SEO services
  VIDEOGRAPHY // Videography services
  VISUAL_CREATIVE // Visual creative services
  SOCIAL_MEDIA_MARKETING // Social media marketing services
  PAY_PER_CLICK_ADVERTISING // PPC advertising services
}

enum HostingOperation {
  PROVISION
  RENEWAL
  UPGRADE
  DOWNGRADE
  SUSPEND
  UNSUSPEND
  TERMINATE
}

enum ProvisioningMethod {
  MANUAL // Provisioned manually by admin
  AUTOMATIC // Provisioned automatically when customer orders
}

enum PromoType {
  PERCENTAGE // Percentage discount (e.g., 20% off)
  FIXED // Fixed amount discount (e.g., $50 off)
}

enum PromoScope {
  PUBLIC // Available to all customers
  USER_SPECIFIC // Only for specific users
}

enum PromoTarget {
  HOSTING_PLAN // Promo for hosting plans
  DOMAIN_REGISTRATION // Promo for domain registration
  DOMAIN_RENEWAL // Promo for domain renewal
  DOMAIN_TRANSFER // Promo for domain transfer
}

enum CustomerPlatform {
  PLESK // Plesk hosting platform
  OPENPROVIDER // OpenProvider domain platform
  KENIC // KENIC EPP (.ke and other KENIC TLDs)
}

enum MarginType {
  PERCENTAGE
  FIXED
}

// Customer integration tracking for external platforms
model CustomerIntegration {
  id       String           @id @map("_id")
  userId   String // User who owns this customer account
  platform CustomerPlatform // Which platform (PLESK, OPENPROVIDER)

  // Platform-specific IDs
  platformCustomerId String? // Customer ID on the platform (Plesk owner ID, OpenProvider handle)

  // Account Status
  isActive  Boolean @default(true) // Whether account is active on platform
  isCreated Boolean @default(false) // Whether account was successfully created

  // Creation Tracking
  createdBy    String? // User who created the account on platform
  createdAt    DateTime // When account was created
  lastSyncedAt DateTime? // When account was last synced

  // Additional Platform Data
  platformData Json? // Additional platform-specific data (e.g., Plesk owner details, OpenProvider customer info)

  // Timestamps
  updatedAt DateTime

  // Relations
  user                 User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  domains              Domain[]
  hostingSubscriptions HostingSubscription[]
  activityLogs         CustomerIntegrationActivityLog[]

  @@unique([userId, platform]) // One customer account per platform per user
  @@index([userId])
  @@index([platform])
  @@index([platformCustomerId])
  @@index([isActive])
  @@index([isCreated])
  @@map("customer_integration")
}

// WordPress instances tracking for teams
model WordPressInstance {
  id                    String  @id @map("_id")
  teamId                String // Team that owns this WordPress instance
  hostingSubscriptionId String? // Optional link to hosting subscription

  // WordPress Toolkit Integration
  installationId Int @unique // WordPress installation ID from WP Toolkit API

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  team                Team                           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hostingSubscription HostingSubscription?           @relation(fields: [hostingSubscriptionId], references: [id], onDelete: SetNull)
  activityLogs        WordPressInstanceActivityLog[]

  @@index([teamId])
  @@index([installationId])
  @@map("wordpress_instance")
}

// Promo system for hosting plans and domains
model Promo {
  id          String  @id @map("_id")
  code        String  @unique // Promo code (e.g., "SAVE20", "WELCOME50")
  name        String // Promo name (e.g., "Black Friday Sale", "New Customer Discount")
  description String? // Promo description

  // Promo Configuration
  type   PromoType // PERCENTAGE or FIXED
  scope  PromoScope // PUBLIC or USER_SPECIFIC
  target PromoTarget // What this promo applies to

  // Discount Details
  discountValue String // Discount amount (percentage or fixed amount)
  currency      String? @default("KES") // Currency for fixed discounts

  // Validity Period
  startDate DateTime // When promo becomes active
  endDate   DateTime? // When promo expires (null = no expiry)

  // Usage Limits
  usageLimit    Int? // Maximum number of uses (null = unlimited)
  usageCount    Int     @default(0) // Current usage count
  minOrderValue String? // Minimum order value to use promo

  // Targeting
  hostingPlanId String? // Specific hosting plan (if target is HOSTING_PLAN)
  userId        String? // Specific user (if scope is USER_SPECIFIC)
  teamId        String? // Team that owns this promo

  // Status
  isActive Boolean @default(true)

  // Tracking
  createdBy String // User who created the promo
  createdAt DateTime
  updatedAt DateTime

  // Relations
  hostingPlan  HostingPlan?       @relation(fields: [hostingPlanId], references: [id], onDelete: SetNull)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  orders       Order[]
  activityLogs PromoActivityLog[]

  @@index([code])
  @@index([target])
  @@index([scope])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([hostingPlanId])
  @@index([userId])
  @@map("promo")
}

enum DomainStatus {
  ACTIVE
  PENDING
  INACTIVE
  PROCESSING
  EXPIRED
  TRANSFERRING
  REQUESTED // OpenProvider: domain registration requested, awaiting processing
  FAILED // OpenProvider: transfer failed
  PENDING_TRANSFER // OpenProvider: transfer initiated, awaiting approval
  CLIENT_TRANSFER_PROHIBITED // OpenProvider: domain locked after transfer
}

enum DomainCycle {
  ANNUAL
  BIENNIALLY
  CUSTOM
}

model User {
  id                 String     @id @map("_id")
  name               String
  email              String
  emailVerified      Boolean    @default(false)
  image              String?
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  lastAccessedTeamId String?
  lastLoginAt        DateTime?

  // Notification Preferences
  notificationSoundEnabled         Boolean?  @default(true)
  browserNotificationsEnabled      Boolean?  @default(false)
  notificationSoundVolume          Int?      @default(100) // 0-100
  browserNotificationPermission    String?   @default("default") // "default" | "granted" | "denied"
  notificationPreferencesUpdatedAt DateTime?

  createdAt                     DateTime
  updatedAt                     DateTime
  sessions                      Session[]
  accounts                      Account[]
  teamMemberships               TeamMember[]
  profile                       UserProfile?
  customerIntegrations          CustomerIntegration[]
  domains                       Domain[]
  domainRenewals                DomainRenewal[]               @relation("DomainRenewalCreatedBy")
  createdDomainTransfers        DomainTransfer[]              @relation("DomainTransferCreatedBy")
  activityLogs                  UserActivityLog[]
  // Social Media Marketing Relations
  socialMediaIntegrations       SocialMediaIntegration[]
  socialMediaPageTokens         SocialMediaPageToken[]
  metaContentCalendarPosts      MetaContentCalendar[]
  LinkedInContentCalendar       LinkedInContentCalendar[]
  // Google Ads Relations
  googleAdsIntegrations         GoogleAdsIntegration[]
  // Meta Ads Relations (via activity logs - accounts are linked to integrations)
  metaAdsAccountActivityLogs    MetaAdsAccountActivityLog[]
  metaAdsCampaignActivityLogs   MetaAdsCampaignActivityLog[]
  metaAdsAdSetActivityLogs      MetaAdsAdSetActivityLog[]
  metaAdsAdActivityLogs         MetaAdsAdActivityLog[]
  // ImageGen Studio Relations
  imageGenProjects              ImageGenProject[]
  imageGenTemplates             ImageGenTemplate[]
  ImageGenUpload                ImageGenUpload[]
  imageGenAiGenerations         ImageGenAiGeneration[]
  // Image Generator Relations
  imageGeneratorGenerations     ImageGeneratorGeneration[]
  backgroundRemoverGenerations  BackgroundRemoverGeneration[]
  // Ticket System Relations
  createdTickets                Ticket[]                      @relation("CreatedTickets")
  assignedTickets               Ticket[]                      @relation("AssignedTickets")
  ticketMessages                TicketMessage[]               @relation("TicketMessages")
  ticketAttachments             TicketAttachment[]            @relation("TicketAttachments")
  // Creative Briefs Relations
  creativeBriefs                CreativeBrief[]               @relation("CreatedBriefs")
  approvedCreativeBriefs        CreativeBrief[]               @relation("ApprovedBriefs")
  // Web Design Quote Requests (submitted via domain portfolio dialog)
  webDesignQuoteRequests        WebDesignQuoteRequest[]
  // Notifications Relations
  notifications                 Notification[]
  // SEO Reports Relations
  seoReports                    SeoReport[]
  // Email Marketing Relations
  emailDomains                  EmailDomain[]
  emailCampaigns                EmailCampaign[]
  EmailBuilderDesign            EmailBuilderDesign[]
  aiChats                       AiChat[]
  niscOrders                    NiscOrder[]
  quotations                    Quotation[]
  createdDomainTransferRequests DomainTransferRequest[]       @relation("DomainTransferRequestCreatedBy")

  @@unique([email])
  @@index([role])
  @@index([status])
  @@index([lastAccessedTeamId])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Team {
