// User role for customer vs agency/admin distinction
enum UserRole {
  CUSTOMER
  AGENCY_ADMIN
  AGENCY_SUPER_ADMIN
  AGENCY_USER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum BillingCycle {
  YEARLY
  MONTHLY
  BIENNIALLY
  CUSTOM  
}

enum HostingStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  PENDING
  PROCESSING
  FAILED
  EXPIRED
}

enum HostingType {
  WEB_HOSTING      // Full web hosting with databases, FTP, etc.
  EMAIL_HOSTING    // Email-only hosting without database access
  RESELLER_HOSTING // Reseller hosting plans
  VPS_HOSTING      // VPS hosting plans
  DEDICATED_HOSTING // Dedicated server hosting
}

enum HostingOperation {
  PROVISION
  RENEWAL
  UPGRADE
  DOWNGRADE
  SUSPEND
  UNSUSPEND
  TERMINATE
}

enum ProvisioningMethod {
  MANUAL      // Provisioned manually by admin
  AUTOMATIC   // Provisioned automatically when customer orders
}

enum PromoType {
  PERCENTAGE  // Percentage discount (e.g., 20% off)
  FIXED       // Fixed amount discount (e.g., $50 off)
}

enum PromoScope {
  PUBLIC      // Available to all customers
  USER_SPECIFIC // Only for specific users
}

enum PromoTarget {
  HOSTING_PLAN      // Promo for hosting plans
  DOMAIN_REGISTRATION // Promo for domain registration
  DOMAIN_RENEWAL    // Promo for domain renewal
  DOMAIN_TRANSFER   // Promo for domain transfer
}

enum OrderStatus {
  PENDING           // Order placed, awaiting processing
  PROCESSING        // Order being processed
  COMPLETED         // Order completed successfully
  FAILED            // Order failed
  CANCELLED         // Order cancelled
  REFUNDED          // Order refunded
  PARTIAL           // Order partially completed
}

enum OrderType {
  DOMAIN_REGISTRATION // Domain registration order
  DOMAIN_RENEWAL     // Domain renewal order
  DOMAIN_TRANSFER    // Domain transfer order
  HOSTING_SUBSCRIPTION // Hosting subscription order
  HOSTING_RENEWAL    // Hosting renewal order
  HOSTING_UPGRADE    // Hosting upgrade order
  EMAIL_HOSTING      // Email hosting order
  SSL_CERTIFICATE    // SSL certificate order
  BACKUP_SERVICE     // Backup service order
  CUSTOM_SERVICE     // Custom service order
}

enum CustomerPlatform {
  PLESK         // Plesk hosting platform
  OPENPROVIDER  // OpenProvider domain platform
}

enum MarginType {
  PERCENTAGE
  FIXED
}

// Customer integration tracking for external platforms
model CustomerIntegration {
  id              String        @id @map("_id")
  userId          String        // User who owns this customer account
  platform        CustomerPlatform // Which platform (PLESK, OPENPROVIDER)
  
  // Platform-specific IDs
  platformCustomerId String?    // Customer ID on the platform (Plesk owner ID, OpenProvider handle)
  
  // Account Status
  isActive        Boolean       @default(true) // Whether account is active on platform
  isCreated       Boolean       @default(false) // Whether account was successfully created
  
  // Creation Tracking
  createdBy       String?       // User who created the account on platform
  createdAt       DateTime      // When account was created
  lastSyncedAt    DateTime?     // When account was last synced
  
  // Additional Platform Data
  platformData    Json?         // Additional platform-specific data (e.g., Plesk owner details, OpenProvider customer info)
  
  // Timestamps
  updatedAt       DateTime
  
  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainRegistrations DomainRegistration[]
  hostingSubscriptions HostingSubscription[]
  activityLogs    CustomerIntegrationActivityLog[]
  
  @@unique([userId, platform]) // One customer account per platform per user
  @@index([userId])
  @@index([platform])
  @@index([platformCustomerId])
  @@index([isActive])
  @@index([isCreated])
  @@map("customer_integration")
}

// WordPress instances tracking for teams
model WordPressInstance {
  id                String        @id @map("_id")
  teamId            String        // Team that owns this WordPress instance
  hostingSubscriptionId String?   // Optional link to hosting subscription
  
  // WordPress Toolkit Integration
  installationId    Int           @unique // WordPress installation ID from WP Toolkit API
  
  // Timestamps
  createdAt         DateTime
  updatedAt         DateTime
  
  // Relations
  team              Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hostingSubscription HostingSubscription? @relation(fields: [hostingSubscriptionId], references: [id], onDelete: SetNull)
  activityLogs      WordPressInstanceActivityLog[]
  
  @@index([teamId])
  @@index([installationId])
  @@map("wordpress_instance")
}

// Order system for all services (domains, hosting, etc.)
model Order {
  id              String        @id @map("_id")
  orderNumber     String        @unique // Unique order number (e.g., "ORD-2024-001")
  teamId          String        // Team that placed the order
  createdBy       String?       // User who created the order (admin or customer)
  
  // Order Details
  type            OrderType     // Type of service being ordered
  status          OrderStatus   @default(PENDING)
  description     String?       // Order description
  
  // Service References (flexible for different service types)
  domainRegistrationId String? // Reference to domain registration
  domainRenewalId      String? // Reference to domain renewal
  domainTransferId     String? // Reference to domain transfer
  hostingSubscriptionId String? // Reference to hosting subscription
  hostingRenewalId     String? // Reference to hosting renewal
  
  // Pricing Information
  subtotal        String?       // Subtotal before discounts
  discount        String?       // Discount amount applied
  total           String?       // Final total amount
  currency        String        @default("KES")
  
  // Promo Information
  promoCode       String?       // Promo code used
  promoId         String?       // Reference to promo
  
  // Invoice Tracking
  invoiceNumber   String?       // Invoice number for this order
  
  // Order Processing
  processedBy     String?       // User who processed the order
  processedAt     DateTime?     // When order was processed
  completedAt     DateTime?     // When order was completed
  
  // Additional Information
  notes           String?       // Additional notes
  metadata        Json?         // Flexible metadata for order-specific data
  
  // Timestamps
  createdAt       DateTime
  updatedAt       DateTime
  
  // Relations
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  domainRegistration DomainRegistration? @relation(fields: [domainRegistrationId], references: [id], onDelete: SetNull)
  domainRenewal   DomainRenewal? @relation(fields: [domainRenewalId], references: [id], onDelete: SetNull)
  domainTransfer  DomainTransfer? @relation(fields: [domainTransferId], references: [id], onDelete: SetNull)
  hostingSubscription HostingSubscription? @relation(fields: [hostingSubscriptionId], references: [id], onDelete: SetNull)
  hostingRenewal  HostingRenewal? @relation(fields: [hostingRenewalId], references: [id], onDelete: SetNull)
  promo           Promo?       @relation(fields: [promoId], references: [id], onDelete: SetNull)
  activityLogs    OrderActivityLog[]
  
  @@index([orderNumber])
  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([processedAt])
  @@index([completedAt])
  @@map("order")
}

// Promo system for hosting plans and domains
model Promo {
  id              String        @id @map("_id")
  code            String        @unique // Promo code (e.g., "SAVE20", "WELCOME50")
  name            String        // Promo name (e.g., "Black Friday Sale", "New Customer Discount")
  description     String?       // Promo description
  
  // Promo Configuration
  type            PromoType     // PERCENTAGE or FIXED
  scope           PromoScope    // PUBLIC or USER_SPECIFIC
  target          PromoTarget   // What this promo applies to
  
  // Discount Details
  discountValue   String        // Discount amount (percentage or fixed amount)
  currency        String?       @default("KES") // Currency for fixed discounts
  
  // Validity Period
  startDate       DateTime      // When promo becomes active
  endDate         DateTime?     // When promo expires (null = no expiry)
  
  // Usage Limits
  usageLimit      Int?          // Maximum number of uses (null = unlimited)
  usageCount      Int           @default(0) // Current usage count
  minOrderValue   String?       // Minimum order value to use promo
  
  // Targeting
  hostingPlanId   String?       // Specific hosting plan (if target is HOSTING_PLAN)
  userId          String?       // Specific user (if scope is USER_SPECIFIC)
  teamId          String?       // Team that owns this promo
  
  // Status
  isActive        Boolean       @default(true)
  
  // Tracking
  createdBy       String        // User who created the promo
  createdAt       DateTime
  updatedAt       DateTime
  
  // Relations
  hostingPlan     HostingPlan?  @relation(fields: [hostingPlanId], references: [id], onDelete: SetNull)
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  orders          Order[]
  activityLogs    PromoActivityLog[]
  
  @@index([code])
  @@index([target])
  @@index([scope])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([hostingPlanId])
  @@index([userId])
  @@map("promo")
}

enum DomainStatus {
    ACTIVE
    PENDING
    INACTIVE
    PROCESSING
    EXPIRED
    TRANSFERRING
    REQUESTED        // OpenProvider: domain registration requested, awaiting processing
    FAILED           // OpenProvider: transfer failed
    PENDING_TRANSFER  // OpenProvider: transfer initiated, awaiting approval
    CLIENT_TRANSFER_PROHIBITED // OpenProvider: domain locked after transfer
}

enum DomainCycle {
  ANNUAL
  BIENNIALLY
  CUSTOM
}

enum DomainOperation {
  REGISTRATION
  RENEWAL
  TRANSFER
  RESTORATION
}



model User {
  id                  String        @id @map("_id")
  name            String
  email               String
  emailVerified       Boolean      @default(false)
  image               String?
  role                UserRole     @default(CUSTOMER)
  status              UserStatus   @default(ACTIVE)
  lastAccessedTeamId  String?
  lastLoginAt         DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  sessions            Session[]
  accounts            Account[]
  teamMemberships     TeamMember[]
  profile             UserProfile?
  customerIntegrations CustomerIntegration[]
  activityLogs        UserActivityLog[]
  // Email Marketing Relations
  emailDomains        EmailDomain[]
  emailCampaigns       EmailCampaign[]
  audiences           Audience[]

  @@unique([email])
  @@index([role])
  @@index([status])
  @@index([lastAccessedTeamId])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Team {
  id           String        @id @map("_id")
  name         String
  slug         String        @unique
  baseCurrency String        @default("KES")
  logoUrl      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime
  updatedAt    DateTime
  createdById  String
  members      TeamMember[]
  invites      TeamInvite[]
  domainRegistrations DomainRegistration[]
  hostingSubscriptions HostingSubscription[]
  wordpressInstances WordPressInstance[]
  promos Promo[]
  orders Order[]
  // Email Marketing Relations
  emailDomains EmailDomain[]
  emailCampaigns EmailCampaign[]
  audiences    Audience[]
  // Creative Assets Relations
  creativeAssets CreativeAsset[]

  @@index([slug])
  @@index([createdById])
  @@index([isActive])
  @@map("team")
}

model TeamMember {
  id        String    @id @map("_id")
  teamId    String
  userId    String
  role      TeamRole  @default(MEMBER)
  createdAt DateTime
  updatedAt DateTime
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

model TeamInvite {
  id          String       @id @map("_id")
  code        String       @unique
  teamId      String
  email       String
  role        TeamRole  @default(MEMBER)
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([code])
  @@index([teamId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("team_invite")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}



// Extended user profile information
model UserProfile {
  id          String   @id @map("_id")
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  createdAt   DateTime
  updatedAt   DateTime

  @@index([userId])
  @@map("user_profile")
}

// Activity logging for user actions and status changes
model UserActivityLog {
  id          String     @id @map("_id")
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String     // e.g., "LOGIN", "LOGOUT", "STATUS_CHANGE", "ROLE_CHANGE", "TEAM_JOIN", "TEAM_LEAVE"
  description String?
  metadata    Json?      // Additional data about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_activity_log")
}



// Hosting plan templates/definitions
model HostingPlan {
  id              String        @id @map("_id")
  name            String        // Plan name (e.g., "Basic Web Hosting", "Email Only")
  description     String?       // Plan description
  hostingType     HostingType   // Type of hosting service
  
  // Plesk Integration
  pleskServicePlanId String?    // Plesk service plan ID
  pleskFilterId      String?    // Plesk filter ID for provisioning
  pleskIpAddress     String?    // IP address for this plan type
  
  // Marketing Features (for landing pages)
  features           String[]   // Array of marketing features (e.g., ["Unlimited Email", "SSL Certificate", "24/7 Support"])
  highlights         String[]   // Array of key highlights (e.g., ["Best Value", "Most Popular", "Enterprise Grade"])
  isPopular          Boolean    @default(false) // Mark as popular plan
  isRecommended      Boolean    @default(false) // Mark as recommended plan
  
  // Pricing
  niscPrice       String?       // Our selling price
  niscCurrency    String?       @default("KES")
  
  // Billing
  billingCycle    BillingCycle  @default(MONTHLY)
  setupFee        String?       // One-time setup fee
  
  // Status
  isActive        Boolean       @default(true)
  isDefault       Boolean       @default(false)
  
  // Timestamps
  createdAt       DateTime
  updatedAt       DateTime
  
  // Relations
  subscriptions   HostingSubscription[]
  promos          Promo[]
  activityLogs    HostingPlanActivityLog[]
  
  @@index([hostingType])
  @@index([isActive])
  @@map("hosting_plan")
}

// Hosting subscription instances
model HostingSubscription {
  id                String        @id @map("_id")
  hostingPlanId     String        // Reference to hosting plan
  teamId            String?       // Team that owns this subscription
  provisionedBy     String?       // User ID who provisioned this service
  
  // Plesk Integration
  pleskFilterId     String        @unique // Critical for Plesk communication
  pleskOwnerId      String?       // Plesk owner ID
  pleskServiceId    String?       // Plesk service ID
  
  // Plesk Subscription Fields (from API)
  pleskName         String?       // Subscription name in Plesk
  pleskStatus       Int?          // Plesk status (0=active, etc.)
  pleskDescription  String?       // Description in Plesk
  pleskAdminDescription String?   // Admin description
  
  // Auto-generated Plesk credentials
  pleskFtpLogin     String?       // Auto-generated FTP login
  pleskFtpPassword  String?       // Auto-generated FTP password
  
  // Domain Integration
  primaryDomain     String?       // Primary domain for this hosting
  domainRegistrationId String?   // Reference to domain registration
  
  // Service Details
  operation         HostingOperation @default(PROVISION)
  provisioningMethod ProvisioningMethod @default(AUTOMATIC) // How it was provisioned
  status            HostingStatus   @default(PENDING)
  hostingType       HostingType     // Type of hosting
  
  // Billing Information
  billingCycle      BillingCycle   @default(MONTHLY)
  nextRenewalDate   DateTime?       // When next renewal is due
  expiryDate        DateTime?       // When subscription expires
  
  // Pricing Information
  niscPrice         String?         // Price we charged
  niscCurrency      String?         @default("KES")
  
  // Invoice tracking
  invoiceNumber     String?         // Invoice number for this subscription
  
  // Customer Integration
  customerIntegrationId String?     // Reference to customer integration (Plesk)
  
  // Additional Info
  notes             String?         // Additional notes
  autoRenew         Boolean         @default(true)
  
  // Timestamps
  createdAt         DateTime
  updatedAt         DateTime
  
  // Relations
  hostingPlan       HostingPlan     @relation(fields: [hostingPlanId], references: [id], onDelete: Restrict)
  team              Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  domainRegistration DomainRegistration? @relation(fields: [domainRegistrationId], references: [id], onDelete: SetNull)
  renewals          HostingRenewal[]
  orders            Order[]
  customerIntegration CustomerIntegration? @relation(fields: [customerIntegrationId], references: [id], onDelete: SetNull)
  wordpressInstances WordPressInstance[]
  activityLogs      HostingSubscriptionActivityLog[]
  
  @@index([hostingPlanId])
  @@index([teamId])
  @@index([pleskFilterId])
  @@index([status])
  @@index([nextRenewalDate])
  @@index([expiryDate])
  @@index([primaryDomain])
  @@map("hosting_subscription")
}

// Individual hosting renewal records
model HostingRenewal {
  id                    String        @id @map("_id")
  hostingSubscriptionId String
  renewedBy             String?       // User ID who renewed the hosting
  renewalDate           DateTime      // When renewal was processed
  expiryDate            DateTime      // New expiry date after renewal
  billingCycle          BillingCycle  // Cycle for this renewal
  status                HostingStatus @default(ACTIVE)
  
  // Pricing information
  niscPrice             String?       // Price we charged for renewal
  niscCurrency          String?       @default("KES")
  
  // Invoice tracking
  invoiceNumber         String?       // Invoice number for this renewal
  
  // Additional info
  notes                 String?       // Additional notes
  
  // Timestamps
  createdAt             DateTime
  updatedAt             DateTime
  
  // Relations
  hostingSubscription   HostingSubscription @relation(fields: [hostingSubscriptionId], references: [id], onDelete: Cascade)
  orders               Order[]
  activityLogs          HostingRenewalActivityLog[]
  
  @@index([hostingSubscriptionId])
  @@index([renewalDate])
  @@index([expiryDate])
  @@index([renewedBy])
  @@map("hosting_renewal")
}

// Activity logging for hosting plan actions
model HostingPlanActivityLog {
  id                    String        @id @map("_id")
  userId                String
  hostingPlanId         String
  hostingPlan           HostingPlan   @relation(fields: [hostingPlanId], references: [id], onDelete: Cascade)
