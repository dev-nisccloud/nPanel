  userId                String
  hostingRenewalId      String
  hostingRenewal        HostingRenewal @relation(fields: [hostingRenewalId], references: [id], onDelete: Cascade)
  action                String        // e.g., "RENEW", "CANCEL", "REFUND", "UPDATE"
  description           String?
  metadata              Json?         // Additional data about the action
