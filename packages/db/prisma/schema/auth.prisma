  imageGenTemplates            ImageGenTemplate[]
  ImageGenUpload               ImageGenUpload[]
  imageGenAiGenerations        ImageGenAiGeneration[]
  // Image Generator Relations
  imageGeneratorGenerations    ImageGeneratorGeneration[]
  backgroundRemoverGenerations BackgroundRemoverGeneration[]
  // Ticket System Relations
  createdTickets               Ticket[]                      @relation("CreatedTickets")
  assignedTickets              Ticket[]                      @relation("AssignedTickets")
  ticketMessages               TicketMessage[]               @relation("TicketMessages")
  ticketAttachments            TicketAttachment[]            @relation("TicketAttachments")
  // Creative Briefs Relations
  creativeBriefs               CreativeBrief[]
  // Web Design Quote Requests (submitted via domain portfolio dialog)
  webDesignQuoteRequests       WebDesignQuoteRequest[]
  // Notifications Relations
  notifications                Notification[]
  // SEO Reports Relations
  seoReports                   SeoReport[]
  // Email Marketing Relations
  emailDomains                 EmailDomain[]
  contacts                     Contact[]
  campaigns                    Campaign[]
  emailLogs                    EmailLog[]
  emailTemplates               EmailTemplate[]

  @@unique([email])
  @@index([role])
  @@index([status])
  @@index([lastAccessedTeamId])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
