// Activity logging for WordPress instance actions
model WordPressInstanceActivityLog {
  id                    String        @id @map("_id")
  userId                String
  wordpressInstanceId   String
  wordpressInstance     WordPressInstance @relation(fields: [wordpressInstanceId], references: [id], onDelete: Cascade)
  action                String        // e.g., "CREATE", "UPDATE", "SYNC", "ACTIVATE", "DEACTIVATE", "UPDATE_WORDPRESS", "INSTALL_PLUGIN", "UPDATE_PLUGIN"
  description           String?
  metadata              Json?         // Additional data about the action
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime
  
  @@index([userId])
  @@index([wordpressInstanceId])
  @@index([action])
  @@index([createdAt])
  @@map("wordpress_instance_activity_log")
}

// Nameserver entity with proper structure
model Nameserver {
  id                String        @id @map("_id")
  nameserverGroupId String        // Reference to nameserver group
  name              String        // Nameserver name (e.g., "ns1.example.com")
  ipv4              String?       // IPv4 address (optional)
  ipv6              String?       // IPv6 address (optional)
  
  // Timestamps
  createdAt         DateTime
  updatedAt         DateTime
  
  // Relations
  nameserverGroup   NameserverGroup @relation(fields: [nameserverGroupId], references: [id], onDelete: Cascade)
  activityLogs      NameserverActivityLog[]
  
  @@index([nameserverGroupId])
  @@index([name])
  @@map("nameserver")
}

// Nameserver group for organizing TLD settings
model NameserverGroup {
  id          String        @id @map("_id")
  name        String        // Group name (e.g., "Default Nameservers", "Custom DNS")
  description String?       // Optional description
  userId      String        // User who created the group
  isDefault   Boolean       @default(false) // Whether this is the default group
  
  // Timestamps
  createdAt   DateTime
  updatedAt   DateTime
  
  // Relations
  nameservers Nameserver[]  // Array of nameserver records
  tldSettings TldSettings[]
  domainRegistrations DomainRegistration[]
  domainTransfers DomainTransfer[]
  activityLogs NameserverGroupActivityLog[]
  
  @@index([userId])
  @@index([isDefault])
  @@map("nameserver_group")
}

model TldSettings {
  id                String  @id @map("_id")
  name              String
  userId            String
  nameserverGroupId String? // Reference to nameserver group
  marginType        MarginType?
  percentageMargin  String? // Margin when type is PERCENTAGE
  fixedMargin       String? // Margin when type is FIXED
  roundOff          String?
  isDefault         Boolean @default(false) // Whether this is the default TLD setting
  
  // Timestamps
  createdAt         DateTime
  updatedAt         DateTime
  
  // Relations
  nameserverGroup   NameserverGroup? @relation(fields: [nameserverGroupId], references: [id], onDelete: SetNull)
  activityLogs      TldSettingsActivityLog[]
  
  @@index([userId])
  @@index([nameserverGroupId])
  @@index([marginType])
  @@index([isDefault])
  @@map("tld_settings")
}

model TldSettingsActivityLog {
  id          String     @id @map("_id")
  userId      String
  tldSettingId String
  tldSettings TldSettings @relation(fields: [tldSettingId], references: [id], onDelete: Cascade)
  action      String
  description String?
  metadata    Json?      // Additional data about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  @@index([userId])
  @@index([tldSettingId])
  @@index([action])
  @@index([createdAt])
  @@map("tld_settings_activity_log")
}

