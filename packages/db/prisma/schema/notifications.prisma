// Notifications System Schema
// Enables system-wide notifications for users and teams

// Notification Types
enum NotificationType {
  SYSTEM // System-wide notifications
  USER // User-specific notifications
  TEAM // Team-specific notifications
  ORDER // Order/purchase related
  PAYMENT // Payment related
  INVOICE // Invoice related
  DOMAIN // Domain related
  HOSTING // Hosting related
  CREATIVE_BRIEF // Creative brief related
  CREATIVE_ASSET // Creative asset related
  SOCIAL_MEDIA // Social media related
  EMAIL_MARKETING // Email marketing related
  AD_CAMPAIGN // Ad campaign related
  GENERAL // General notifications
}

// Notification Priority
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Main Notification Entity
model Notification {
  id       String               @id @map("_id")
  userId   String // User who receives the notification
  teamId   String? // Optional team association
  type     NotificationType     @default(GENERAL) // Notification type/category
  priority NotificationPriority @default(NORMAL) // Notification priority

  // Notification Content
  title   String? // Optional notification title
  message String // Notification message/content

  // Notification Metadata
  link     String? // Optional link to related resource (e.g., /invoices/123)
  metadata Json? // Additional metadata (action data, related IDs, etc.)

  // Status
  seen   Boolean   @default(false) // Whether notification has been seen
  readAt DateTime? // When notification was read

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs NotificationActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([type])
  @@index([seen])
  @@index([priority])
  @@index([createdAt])
  @@index([userId, seen]) // Composite index for user unseen notifications
  @@index([teamId, seen]) // Composite index for team unseen notifications
  @@map("notification")
}

// Activity Logging for Notifications
model NotificationActivityLog {
  id             String   @id @map("_id")
  notificationId String // Notification reference
  userId         String // User who performed action
  action         String // Action type: CREATE, UPDATE, MARK_SEEN, MARK_UNSEEN, DELETE, SEND, etc.
  description    String? // Human-readable description
  metadata       Json? // Additional action details
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("notification_activity_log")
}
