{
  "name": "@npanel/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "bun run src/scripts/migrate.ts"
  },
  "dependencies": {
    "@npanel/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "tsdown": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "^5"
  }
}
