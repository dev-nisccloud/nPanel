{
  "name": "@npanel/db",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "source": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@npanel/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@npanel/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "tsdown": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "^5"
  }
}
