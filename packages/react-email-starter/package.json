{
  "name": "react-email-starter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./emails": "./emails/index.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "email build && node scripts/fix-spam-check.cjs && node -e \"import fs from 'node:fs'; fs.mkdirSync('dist',{recursive:true}); fs.writeFileSync('dist/.turbo-build','')\"",
    "dev": "email dev",
    "export": "email export",
    "postinstall": "node scripts/fix-spam-check.cjs || true"
  },
  "dependencies": {
    "@react-email/components": "0.5.7",
    "@react-email/render": "^1.3.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.1.2"
  },
  "devDependencies": {
    "@react-email/preview-server": "4.3.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "react-email": "4.3.2"
  }
}
