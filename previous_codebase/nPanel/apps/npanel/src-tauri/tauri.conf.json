{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nisc Cloud nPanel",
  "version": "0.1.0",
  "identifier": "com.nisccloud.npanel",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nisc Cloud nPanel",
        "width": 1200,
        "height": 850,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
