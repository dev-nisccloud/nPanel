// Google Ads Integration Schema
// This schema handles Google Ads API integrations and account management

// Enums for Google Ads Integration
enum GoogleAdsIntegrationStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum GoogleAdsAccountStatus {
  ACTIVE
  PAUSED
  REMOVED
}

// Google Ads Integration
// Stores OAuth tokens (refreshToken, accessToken) for Google Ads API access
// Integration is per-user - each user can have their own Google Ads integration
model GoogleAdsIntegration {
  id String @id @map("_id")

  // User who created/configured this integration
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Integration Status
  status GoogleAdsIntegrationStatus @default(PENDING)

  // OAuth Tokens
  refreshToken         String // Google OAuth 2.0 refresh token (doesn't expire unless revoked)
  accessToken          String // Google OAuth 2.0 access token (expires after 1 hour)
  accessTokenExpiresAt DateTime? // When the access token expires

  // Token Metadata
  scope              String? // Granted permissions/scopes
  tokenType          String? // Token type (e.g., "bearer")
  lastTokenRefreshAt DateTime? // When token was last refreshed

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  accounts     GoogleAdsAccount[]
  activityLogs GoogleAdsIntegrationActivityLog[]

  @@index([status])
  @@index([userId])
  @@map("google_ads_integration")
}

// Google Ads Account
// Represents a Google Ads customer account (ad account)
// Each account is linked to an integration and optionally to a team
model GoogleAdsAccount {
  id String @id @map("_id")

  // Integration relationship
  integrationId String
  integration   GoogleAdsIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Google Ads Customer ID (format: XXX-XXX-XXXX)
  customerId String

  // Account Metadata
  accountName  String? // Account name/descriptive name
  currencyCode String? // Currency code (e.g., "USD", "KES")
  timeZone     String? // Timezone (e.g., "America/New_York")

  // Account Status
  status GoogleAdsAccountStatus @default(ACTIVE)

  // Team association (optional)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt DateTime
  updatedAt DateTime

  // Relations
  activityLogs GoogleAdsAccountActivityLog[]

  @@unique([integrationId, customerId]) // One account per customer ID per integration
  @@index([integrationId])
  @@index([customerId])
  @@index([status])
  @@index([teamId])
  @@map("google_ads_account")
}

// Activity logging for Google Ads integration actions
model GoogleAdsIntegrationActivityLog {
  id            String               @id @map("_id")
  userId        String
  integrationId String
  integration   GoogleAdsIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  action        String // e.g., "CREATE", "UPDATE", "TOKEN_REFRESH", "REVOKE"
  description   String?
  metadata      Json? // Additional data about the action
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime

  @@index([userId])
  @@index([integrationId])
  @@index([action])
  @@index([createdAt])
  @@map("google_ads_integration_activity_log")
}

// Activity logging for Google Ads account actions
model GoogleAdsAccountActivityLog {
  id          String           @id @map("_id")
  userId      String
  accountId   String
  account     GoogleAdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  action      String // e.g., "CREATE", "UPDATE", "LINK_TEAM", "UNLINK_TEAM"
  description String?
  metadata    Json? // Additional data about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  @@index([userId])
  @@index([accountId])
  @@index([action])
  @@index([createdAt])
  @@map("google_ads_account_activity_log")
}
