// Web Design Quote Requests
// Stores customer/agency submissions from the "Get Professional Web Design & Development" dialog

enum WebDesignProjectType {
  NEW_WEBSITE
  REDESIGN
  ECOMMERCE
  LANDING_PAGE
  WEB_APP
  OTHER
}

enum WebDesignQuoteStatus {
  PENDING // Submitted, awaiting contact
  CONTACTED // Agency has made contact
  QUOTED // Quote sent to customer
  ACCEPTED // Customer accepted quote
  DECLINED // Customer declined or project cancelled
  EXPIRED // Quote expired
}

model WebDesignQuoteRequest {
  id                 String               @id @map("_id")
  name               String // Full name
  email              String // Email
  phone              String // Phone number
  companyName        String // Company name
  domain             String? // Domain (optional)
  projectType        WebDesignProjectType // Project type
  projectDescription String // Project description & requirements
  budget             String // Budget range (free text)
  targetLaunchDate   DateTime? // When they need it (optional)
  status             WebDesignQuoteStatus @default(PENDING)

  submittedById String? // User who submitted (if logged in)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submittedBy User? @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
  @@index([createdAt])
  @@index([email])
  @@map("web_design_quote_request")
}
