// Invoicing Schema
// Provides relational storage for invoices, line items, payment transactions, and activity logging

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

enum InvoicePaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoicePaymentMethod {
  BANK_TRANSFER
  MPESA
  CHEQUE
  CASH
  CARD
  OTHER
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOIDED
}

// Core invoice record with flexible metadata for editor content
model Invoice {
  id              String        @id @map("_id")
  teamId          String? // Optional team being invoiced
  customerId      String? // Optional customer reference (future CRM integration)
  customerName    String?
  customerEmail   String?
  invoiceNumber   String? // Human-readable invoice number (e.g., INV-001)
  token           String        @unique // Public token for sharing and PDFs
  status          InvoiceStatus @default(DRAFT)
  amount          String? // Total amount due
  subtotal        String? // Subtotal before tax/discount
  tax             String? // Combined tax amount
  taxPercentage   Float? // Tax percentage applied to the invoice
  vat             String? // VAT amount if applicable
  discount        String? // Discount applied
  currency        String        @default("KES")
  creditedAmount  String? // Total amount credited via credit notes
  creditBalance   String? // Remaining balance after credits
  issueDate       DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  sentAt          DateTime?
  reminderSentAt  DateTime?
  viewedAt        DateTime?
  note            String?
  internalNote    String?
  fromDetails     Json? // Structured agency details (editor content)
  customerDetails Json? // Structured customer details (editor content)
  paymentDetails  Json? // Payment instructions (editor content)
  noteDetails     Json? // Additional notes (editor content)
  template        Json? // Serialized template configuration
  topBlock        Json? // Rich content block above line items
  bottomBlock     Json? // Rich content block below totals
  metadata        Json? // Additional context (e.g., reminder schedules)
  createdBy       String // User who created the invoice
  updatedBy       String?
  createdAt       DateTime
  updatedAt       DateTime

  // KRA eTIMS Metadata
  kraInvoiceNumber String? // KRA internal invoice number
  kraReceiptNumber String? // KRA receipt number (if different)
  kraSignature     String? // KRA verification signature
  kraQrCode        String? // KRA QR code data/URL
  kraVerifiedDate  DateTime? // When KRA verified the invoice
  kraStatus        String? // e.g. "SUCCESS", "FAILED"
  kraError         String? // Error message if KRA submission failed

  // Relations
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]
  transactions InvoiceTransaction[]
  orders       Order[]
  niscOrders   NiscOrder[]
  creditNote   CreditNote?          @relation("InvoiceCreditNote")
  activityLogs InvoiceActivityLog[]

  @@unique([teamId, invoiceNumber])
  @@index([teamId])
  @@index([status])
  @@index([dueDate])
  @@index([sentAt])
  @@index([invoiceNumber])
  @@map("invoice")
}

// Individual invoice line items to support analytics and reporting
model InvoiceLineItem {
  id          String   @id @map("_id")
  invoiceId   String
  position    Int      @default(0) // Ordering within invoice
  name        String?
  description String?
  quantity    Float?
  unit        String?
  price       String? // Unit price
  discount    String? // Discount for this line
  total       String? // Total for this line after adjustments
  metadata    Json? // Additional structured data (e.g., product references)
  createdAt   DateTime
  updatedAt   DateTime

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([position])
  @@map("invoice_line_item")
}

// Payment transactions tied to invoices to support partial payments and audits
model InvoiceTransaction {
  id                String               @id @map("_id")
  invoiceId         String
  reference         String? // Internal reference or friendly label
  providerReference String? // External reference (e.g., MPESA code)
  status            InvoicePaymentStatus @default(PENDING)
  method            InvoicePaymentMethod
  amount            String // Amount captured in this transaction
  currency          String               @default("KES")
  paidAt            DateTime? // When funds were received
  notes             String?
  metadata          Json? // Raw gateway payload or contextual data
  recordedBy        String? // User who captured the transaction
  balanceBefore     String? // Balance before applying this payment
  balanceAfter      String? // Balance after applying this payment
  createdAt         DateTime
  updatedAt         DateTime

  invoice      Invoice                         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  activityLogs InvoiceTransactionActivityLog[]

  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@map("invoice_transaction")
}

// Credit notes issued against invoices to manage refunds or adjustments
model CreditNote {
  id           String           @id @map("_id")
  invoiceId    String           @unique
  teamId       String?
  creditNumber String? // Human-readable credit note identifier
  status       CreditNoteStatus @default(DRAFT)
  amount       String // Amount credited back to the customer
  currency     String           @default("KES")
  reason       String?
  note         String?
  metadata     Json?
  issuedAt     DateTime?
  appliedAt    DateTime?
  createdBy    String // User who issued the credit note
  updatedBy    String?
  createdAt    DateTime
  updatedAt    DateTime

  invoice      Invoice                 @relation("InvoiceCreditNote", fields: [invoiceId], references: [id], onDelete: Cascade)
  team         Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs CreditNoteActivityLog[]

  @@index([teamId])
  @@index([status])
  @@index([issuedAt])
  @@map("invoice_credit_note")
}

// Activity logging for invoice lifecycle changes
model InvoiceActivityLog {
  id          String   @id @map("_id")
  invoiceId   String
  userId      String
  action      String // e.g., CREATE, SEND, REMIND, UPDATE, CANCEL, WRITE_OFF
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("invoice_activity_log")
}

// Activity logging for payment transactions
model InvoiceTransactionActivityLog {
  id                   String   @id @map("_id")
  invoiceTransactionId String
  userId               String
  action               String // e.g., RECORD_PAYMENT, UPDATE_PAYMENT, REFUND_PAYMENT
  description          String?
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime

  invoiceTransaction InvoiceTransaction @relation(fields: [invoiceTransactionId], references: [id], onDelete: Cascade)

  @@index([invoiceTransactionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("invoice_transaction_activity_log")
}

// Activity logging for credit note lifecycle changes
model CreditNoteActivityLog {
  id           String   @id @map("_id")
  creditNoteId String
  userId       String
  action       String // e.g., CREATE, ISSUE, APPLY, VOID
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("invoice_credit_note_activity_log")
}

// Invoice number counter - tracks the last used invoice number for sequential generation
model InvoiceCounter {
  id         String   @id @default("invoice-counter")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_counter")
}
