model AgencyRole {
  id          String  @id @map("_id")
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime
  updatedAt DateTime

  users       User[]
  permissions AgencyRolePermission[]

  @@index([name])
  @@map("agency_role")
}

model AgencyPermission {
  id          String  @id @map("_id")
  key         String  @unique
  description String?

  createdAt DateTime
  updatedAt DateTime

  roles AgencyRolePermission[]

  @@index([key])
  @@map("agency_permission")
}

model AgencyRolePermission {
  id           String @id @map("_id")
  roleId       String
  permissionId String

  createdAt DateTime

  role       AgencyRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AgencyPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("agency_role_permission")
}
