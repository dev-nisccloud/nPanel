// Image Generator - AI Image Generation Schema
// Stores prompts and generations for the image generator feature

// Generation status (ImageGeneratorGeneration.status): QUEUED → PROCESSING → COMPLETED or FAILED.
// Individual image/variation status (ImageGeneratorVariation.status): PROCESSING → COMPLETED or FAILED.

// Image Generator - AI Generations (prompts and generation metadata)
// One generation can have multiple variations. Status drives UI (loaders vs loaded).
model ImageGeneratorGeneration {
  id     String  @id @map("_id")
  userId String // User who generated the image
  teamId String? // Optional team ownership (null = personal generation)

  // Generation Details
  prompt             String // The text prompt used
  referenceImageUrls Json? // Array of reference image URLs (stored as JSON array)

  // Generation Settings
  aspectRatio     String // e.g., "1:1", "16:9", etc.
  outputFormat    String // e.g., "png", "jpg"
  resolution      String // e.g., "1K", "2K", "4K"
  variationsCount Int // Number of variations requested

  // Model Information
  modelId   String // e.g., "google/nano-banana-pro"
  modelName String? // Human-readable model name

  // Job status (top-level): QUEUED -> PROCESSING -> COMPLETED | FAILED
  status          String    @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  errorMessage    String? // Last error if FAILED
  qstashMessageId String? // QStash message ID for the background job
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime
  updatedAt DateTime

  user         User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  variations   ImageGeneratorVariation[]
  activityLogs ImageGeneratorGenerationActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
  @@index([modelId])
  @@index([status])
  @@map("image_generator_generation")
}

// Image Generator - Individual Variation Images
// Each variation is a separate generated image. Status: PROCESSING (loader) -> COMPLETED (show image) | FAILED
model ImageGeneratorVariation {
  id                         String                   @id @map("_id")
  imageGeneratorGenerationId String
  imageGeneratorGeneration   ImageGeneratorGeneration @relation(fields: [imageGeneratorGenerationId], references: [id], onDelete: Cascade)

  // Variation Index (1, 2, 3, etc.)
  variationIndex Int

  // Variation-level status: PROCESSING (show loader) | COMPLETED | FAILED
  status       String  @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  errorMessage String?

  // Replicate async prediction id (for webhook-based completion updates)
  predictionId String?

  // Generated Image Storage (UploadThing) - set when status = COMPLETED
  imageUrl      String? // UploadThing file URL
  imageKey      String? // UploadThing file key for deletion
  imageFileName String? // Generated file name
  imageSize     Int? // File size in bytes
  imageMimeType String? // File MIME type (should be image/*)
  imageMetadata Json? // Additional metadata (dimensions, seed, etc.)

  createdAt DateTime
  updatedAt DateTime

  @@index([imageGeneratorGenerationId])
  @@index([variationIndex])
  @@index([status])
  @@index([predictionId])
  @@map("image_generator_variation")
}

// Activity logging for Image Generator generation actions
model ImageGeneratorGenerationActivityLog {
  id                         String                   @id @map("_id")
  imageGeneratorGenerationId String
  imageGeneratorGeneration   ImageGeneratorGeneration @relation(fields: [imageGeneratorGenerationId], references: [id], onDelete: Cascade)
  userId                     String
  action                     String // e.g., "GENERATE", "DELETE", "DOWNLOAD", "SHARE"
  description                String?
  metadata                   Json?
  ipAddress                  String?
  userAgent                  String?
  createdAt                  DateTime

  @@index([imageGeneratorGenerationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("image_generator_generation_activity_log")
}

// Background Remover - Background Removal History
// Job status: QUEUED -> PROCESSING -> COMPLETED | FAILED (worker updates processed* when COMPLETED)
model BackgroundRemoverGeneration {
  id     String  @id @map("_id")
  userId String
  teamId String? // Optional team ownership (null = personal generation)

  // Original Image Storage (set when job is created)
  originalImageUrl      String
  originalImageKey      String
  originalImageFileName String
  originalImageSize     Int
  originalImageMimeType String
  originalImageMetadata Json?

  // Processed Image (set by worker when status = COMPLETED)
  processedImageUrl      String?
  processedImageKey      String?
  processedImageFileName String?
  processedImageSize     Int?
  processedImageMimeType String?
  processedImageMetadata Json?

  // Model Information
  modelId   String
  modelName String?

  // Job status: QUEUED -> PROCESSING -> COMPLETED | FAILED
  status          String    @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  errorMessage    String?
  qstashMessageId String?
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime
  updatedAt DateTime

  user         User                                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  activityLogs BackgroundRemoverGenerationActivityLog[]

  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
  @@index([modelId])
  @@index([status])
  @@map("background_remover_generation")
}

// Activity logging for Background Remover generation actions
model BackgroundRemoverGenerationActivityLog {
  id                            String                      @id @map("_id")
  backgroundRemoverGenerationId String
  backgroundRemoverGeneration   BackgroundRemoverGeneration @relation(fields: [backgroundRemoverGenerationId], references: [id], onDelete: Cascade)
  userId                        String
  action                        String // e.g., "GENERATE", "DELETE", "DOWNLOAD", "SHARE"
  description                   String?
  metadata                      Json?
  ipAddress                     String?
  userAgent                     String?
  createdAt                     DateTime

  @@index([backgroundRemoverGenerationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("background_remover_generation_activity_log")
}
