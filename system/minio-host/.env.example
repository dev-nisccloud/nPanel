# ─────────────────────────────────────────────
#  MinIO on the Plesk hosting server
#  Copy to .env and replace the password before ./install.sh
# ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_SITE_NAME=npanel-storage

# Same bucket the app already expects (S3_BUCKET)
MINIO_DEFAULT_BUCKET=npanel-uploads

# Public S3 URL. Plesk terminates TLS and proxies here.
# Presigned upload/download URLs are built from this value.
MINIO_SERVER_URL=https://storage.nisccloud.com

# Directory on the empty disk. Mount the disk first, then point this at it.
# Example: the disk is mounted at /mnt/storage
MINIO_DATA_DIR=/mnt/storage/minio

# Hard caps so MinIO cannot take the CPU and RAM used by sites and mail.
# 1 core and 1 GB is enough for light object storage beside hosting.
MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=1g
