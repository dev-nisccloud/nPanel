# Dedicated address from identify.sh. Must already be on this machine
# and must not be the address Plesk uses for sites and mail.
STORAGE_BIND_IP=change_me_storage_ip

# Public name. DNS A record points at STORAGE_BIND_IP.
# Presigned URLs are built from https:// this name.
DOMAIN_STORAGE=cloudstorage.nisccloud.com
CERTBOT_EMAIL=admin@nisccloud.com

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_SITE_NAME=nisccloudstorage
MINIO_DEFAULT_BUCKET=nisccloudstorage

# On /dev/sdb, mounted at /mnt/backups. Objects stay inside nisc-storage/minio.
# Mail retention and Plesk backups are sibling directories and are not used here.
MINIO_DATA_DIR=/mnt/backups/nisc-storage/minio
LETSENCRYPT_DIR=/mnt/backups/nisc-storage/letsencrypt
CERTBOT_WEBROOT=/mnt/backups/nisc-storage/certbot

# Caps so this stack cannot take the CPU and RAM used by sites and mail.
MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=1g
