# ─────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=npanel
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=npanel

# ─────────────────────────────────────────────
#  PgBouncer
# ─────────────────────────────────────────────
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ─────────────────────────────────────────────
#  MinIO
# ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_SITE_NAME=npanel-storage

# Default bucket that will be created on first run
MINIO_DEFAULT_BUCKET=npanel-uploads

# ─────────────────────────────────────────────
#  MinIO  production domain (set in docker-compose.prod.yml)
#  Leave blank for local development
# ─────────────────────────────────────────────
MINIO_SERVER_URL=

# ─────────────────────────────────────────────
#  Nginx / Certbot  production only
#  Only the MinIO S3 API needs a domain.
#  All admin UIs are accessed via http://<VM-IP>:<port>
# ─────────────────────────────────────────────
DOMAIN_STORAGE=storage.nisccloud.com
CERTBOT_EMAIL=admin@nisccloud.com

# ─────────────────────────────────────────────
#  Grafana (monitoring stack)
# ─────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password
# Production: set to your actual Grafana URL
GRAFANA_URL=http://localhost:3100

# ─────────────────────────────────────────────
#  pgAdmin  (PostgreSQL web GUI — http://localhost:5050)
#
#  ⚠  These are INIT-ONLY values. pgAdmin reads them exactly
#  once when its data volume is empty, then ignores them forever.
#
#  To reset credentials (e.g. after changing this file):
#    docker compose ... down
#    docker volume rm nPanel-pgadmin-data
#    docker compose ... up -d pgadmin
#
#  PGADMIN_EMAIL   → your login e-mail for the pgAdmin web UI
#  PGADMIN_PASSWORD → your login password for the pgAdmin web UI
#                    (this is NOT your Postgres password)
#
#  The Postgres server is pre-registered automatically via
#  monitoring/pgadmin/servers.json — you only need to enter
#  the Postgres password once inside pgAdmin when prompted.
# ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_strong_password

# ─────────────────────────────────────────────
#  Alerting
#  Downtime alerts are handled by Uptime Kuma (configure via its web UI).
#  Alertmanager + Prometheus are not included in this stack to save ~500 MB RAM.
#  Add docker-compose.metrics.yml when you need time-series dashboards.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
#  Backups
# ─────────────────────────────────────────────
# How many days to keep pg_dump backups
BACKUP_RETENTION_DAYS=7
# Cron schedule for backups (default: 2:00 AM daily)
BACKUP_CRON=0 2 * * *
