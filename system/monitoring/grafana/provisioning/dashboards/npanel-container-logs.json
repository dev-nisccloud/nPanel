      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"pgbouncer\"} |~ \"(?i)(error|warning|pool|login|disconnect|timeout|auth)\"",
          "queryType": "range",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "id": 10,
      "title": "MinIO Object Storage",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 47 },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
