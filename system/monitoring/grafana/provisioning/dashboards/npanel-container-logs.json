  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["npanel", "logs", "containers"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({container=~\"nPanel-System-.*\"}, service)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({container=~\"nPanel-System-.*\"}, service)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Service"
      },
      {
        "current": { "selected": true, "text": "All", "value": "" },
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "level_filter",
        "options": [
          { "selected": true, "text": "All", "value": "" },
          { "selected": false, "text": "Errors only", "value": "|~ \"(?i)(error|fatal|panic|critical)\"" },
          { "selected": false, "text": "Warnings only", "value": "|~ \"(?i)(warn)\"" },
          { "selected": false, "text": "Errors + Warnings", "value": "|~ \"(?i)(error|fatal|panic|warn|critical)\"" },
          { "selected": false, "text": "Stderr only", "value": "| stream = \"stderr\"" }
        ],
        "query": "",
        "type": "custom",
        "label": "Filter"
      }
    ]
  },
