        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"postgres\"} |~ \"(?i)(error|fatal|panic|slow|duration|deadlock|connection)\"",
          "queryType": "range",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 34 },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
