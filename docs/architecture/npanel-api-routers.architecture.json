  "cards": [
    {
      "dot": "cyan",
      "title": "How to read this map",
      "items": [
        "Every colored box on the right is a domain of tRPC routers under packages/api → appRouter",
        "Call shape: trpc.<router>.<procedure>  e.g. trpc.orders.create or trpc.plesk.domains.list",
        "Landing Page mainly uses Public Storefront routers (storefront, publicPricing, whois, payments)",
        "nPanel Dashboard uses almost every domain after login"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hosting routers",
      "items": [
        "plesk.*  customers, domains, DNS, email, DBs, FTP, subscriptions, WordPress toolkit",
        "hosting, hostingPlans, wordpressSubscriptions  Nisc hosting catalog & subscriptions",
        "hivelocity, hivelocityPricingSettings  VPS / dedicated servers",
        "jetbackup.*  dashboard, accounts, jobs, schedules, backups, restores, settings"
      ]
    },
    {
      "dot": "violet",
      "title": "Domains routers",
      "items": [
        "openProvider  global domain registrar API",
        "kenic  .ke EPP registry",
        "domains, domainTransfer, nameserverGroups, tldSettings, aiDomainSearch, whois"
      ]
    },
    {
      "dot": "amber",
      "title": "Billing & commerce routers",
      "items": [
        "orders, invoicing, quotations, teamBilling, products",
        "paymentGateway, paymentTransactions  M-Pesa and payment records",
        "clientSubscriptions, subscriptionUsage, serviceSubscriptions, niscServiceOrders",
        "currency, publicPricing  FX and public price helpers"
      ]
    },
    {
      "dot": "rose",
      "title": "Teams, access & public doors",
      "items": [
        "teams, clients, manageUsers, user, userProfile, agencyRbac, apiKeys",
        "storefront  Landing Page cart/checkout (isolated from dashboard routers)",
        "Auth gates: publicProcedure (open) vs protectedProcedure (must be logged in)",
        "Nested giants: plesk.* and jetbackup.* are routers-inside-routers"
      ]
    },
    {
      "dot": "orange",
      "title": "Creatives · email · ads · tax · support",
      "items": [
