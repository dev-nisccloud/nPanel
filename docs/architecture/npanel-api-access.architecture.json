  "cards": [
    {
      "dot": "emerald",
      "title": "PUBLIC_ONLY routers (3)",
      "items": [
        "storefront — Landing Page cart, auth helpers, M-Pesa STK, order create-from-payment",
        "whois — lookup, bulkLookup",
        "publicPricing — margins, FX rates, convertPricesPublic"
      ]
    },
    {
      "dot": "amber",
      "title": "MIXED routers (8)",
      "items": [
        "products — many get*ForPricing public; catalog CRUD protected",
        "openProvider / kenic / domainTransfer — some public domain checks; mutations protected",
        "plesk — healthCheck public; all hosting ops protected",
        "hivelocity + hivelocityPricingSettings — public plan catalogs; manage/deploy protected",
        "teams — getInviteByCode public; everything else protected"
      ]
    },
    {
      "dot": "rose",
      "title": "What protected success requires",
      "items": [
        "1) Valid Better Auth cookie OR valid npanel_sk_* key (key → owner session)",
        "2) Pass MFA_SETUP / MFA_REQUIRED / REAUTH_REQUIRED if flagged on context",
        "3) Pass router checks: team membership, agency RBAC, vendor OAuth, credits, etc.",
        "4) See API-ACCESS-MAP.md for every procedure name under all 69 routers"
      ]
    },
    {
      "dot": "violet",
      "title": "ETIMS_TOGGLE (1 router)",
      "items": [
        "etims.* uses etimsProcedure (31 procedures)",
        "Normal: same as protectedProcedure",
        "Only when ETIMS_CERTIFICATION_PUBLIC=1: temporarily public for KRA certification"
      ]
    },
    {
      "dot": "slate",
      "title": "PROTECTED_ONLY (57 routers)",
      "items": [
        "Dashboard domains: hosting, jetbackup, invoicing, ads, email marketing, creatives/AI, digitax, reports, tickets, apiKeys, agencyRbac, …",
        "No anonymous access — Landing Page must not call these without a session",
        "Full name lists: docs/architecture/API-ACCESS-MAP.md"
      ]
    }
  ]
