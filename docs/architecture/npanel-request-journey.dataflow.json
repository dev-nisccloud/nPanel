  "cards": [
    {
      "dot": "cyan",
      "title": "Two front doors",
      "items": [
        "Landing Page = public marketing + storefront (browse, cart, checkout)",
        "nPanel Dashboard = signed-in system where agencies/customers manage services",
        "Both reach the API through a same-origin /api proxy (cookies stay on the website domain)"
      ]
    },
    {
      "dot": "rose",
      "title": "Security in plain English",
      "items": [
        "Login Check asks: cookie session, MFA, or npanel_sk_* API key?",
        "Redis answers fast; if missing, PostgreSQL is the authority",
        "Workers never trust browser cookies  only QStash signatures"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why jobs are separate",
      "items": [
        "Fast UI work: API ↔ PostgreSQL / Redis / files",
        "Slow work (emails, provisioning, AI): Job Queue → Workers → Partners → write back to PostgreSQL",
        "That split keeps the Landing Page and Dashboard feeling responsive"
      ]
    }
  ]
